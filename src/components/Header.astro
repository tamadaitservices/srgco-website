---
import { firm, nav } from '../data/site';
const path = Astro.url.pathname;
const themes = [
  { id: 'clean', label: 'Clean', title: 'Clean (light, minimal)', dot: 'd-clean' },
  { id: 'navy', label: 'Navy', title: 'Navy & copper', dot: 'd-navy' },
  { id: 'light', label: 'Ledger', title: 'Ledger (light)', dot: 'd-light' },
  { id: 'dark', label: 'Night', title: 'Night (dark)', dot: 'd-dark' },
  { id: 'emerald', label: 'Emerald', title: 'Emerald & gold', dot: 'd-emerald' },
];
---
<header class="site-header sticky top-0 z-30 border-b-[3px] border-double border-ink bg-paper/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-[88rem] items-center justify-between gap-3 px-4 py-3 sm:px-5 sm:py-4">
    <a href="/" class="leading-none" aria-label={`${firm.name} — home`}>
      <span class="brand block whitespace-nowrap font-serif text-lg font-semibold tracking-tight text-pen sm:text-2xl md:text-[1.7rem]">S.R. Garimella <span class="amp">&amp;</span> Co.,</span>
      <span class="label mt-1 hidden sm:block">Chartered Accountants · Est. {firm.established}</span><span class="label mt-0.5 block !text-[0.58rem] sm:hidden">Chartered Accountants</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={['label nav-link !text-[0.72rem] hover:text-pen', path.startsWith(n.href) && '!text-pen underline decoration-stamp decoration-2 underline-offset-8']}
          aria-current={path.startsWith(n.href) ? 'page' : undefined}
        >{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
    <a href="/book" class="nv-pill">Schedule a consultation <span aria-hidden="true">→</span></a>
    <div class="theme-switch hidden sm:inline-flex" role="radiogroup" aria-label="Colour theme" id="theme-switch">
      {themes.map((t) => (
        <button type="button" role="radio" aria-checked="false" data-theme-choice={t.id} title={t.title}><span class={`dot ${t.dot}`}></span><span class="hidden 2xl:inline">{t.label}</span></button>
      ))}
    </div>
    <details class="theme-pop relative sm:hidden" id="theme-pop">
      <summary class="theme-pop-btn" aria-label="Change colour theme"><span class="dot" id="theme-pop-dot"></span><span class="theme-lab label !text-[0.62rem] !text-pen">Theme</span></summary>
      <div class="theme-pop-menu" role="radiogroup" aria-label="Colour theme">
        {themes.map((t) => (
          <button type="button" role="radio" aria-checked="false" data-theme-choice={t.id}><span class={`dot ${t.dot}`}></span><span>{t.label}</span></button>
        ))}
      </div>
    </details>
    <details class="lang-pop relative" id="lang-pop">
      <summary class="theme-pop-btn" aria-label="Language"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg><span class="label !text-[0.68rem] !text-pen" id="lang-cur">EN</span></summary>
      <div class="theme-pop-menu" role="radiogroup" aria-label="Language">
        <button type="button" role="radio" aria-checked="true" data-lang="en"><span>English</span></button>
        <button type="button" role="radio" aria-checked="false" data-lang="te"><span>తెలుగు</span></button>
        <button type="button" role="radio" aria-checked="false" data-lang="hi"><span>हिन्दी</span></button>
      </div>
    </details>
    <details class="relative lg:hidden">
      <summary class="label cursor-pointer list-none whitespace-nowrap !text-pen" aria-label="Menu"><span class="text-xl leading-none sm:hidden" aria-hidden="true">☰</span><span class="hidden sm:inline">Menu ☰</span></summary>
      <nav class="absolute right-0 mt-3 w-56 border border-ink bg-paper p-4" aria-label="Mobile">
        {nav.map((n) => <a href={n.href} class="label block py-2 !text-pen">{n.label}</a>)}
      </nav>
    </details>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const group = document.getElementById('theme-switch');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'));
  const pop = document.getElementById('theme-pop') as HTMLDetailsElement | null;
  const popDot = document.getElementById('theme-pop-dot');
  const dotClass: Record<string, string> = { clean: 'd-clean', navy: 'd-navy', light: 'd-light', dark: 'd-dark', emerald: 'd-emerald' };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sync = () => {
    buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeChoice === root.dataset.theme)));
    if (popDot) popDot.className = 'dot ' + (dotClass[root.dataset.theme || 'navy'] || 'd-navy');
  };
  sync();
  document.addEventListener('srg:theme', sync);

  function setTheme(next: string, origin: HTMLElement) {
    if (next === root.dataset.theme) return;
    const apply = () => { root.dataset.theme = next; sync(); };
    try { localStorage.setItem('srg-theme', next); } catch {}
    const vt = (document as any).startViewTransition;
    if (!vt || reduced) { apply(); return; }
    const r = origin.getBoundingClientRect();
    const x = r.left + r.width / 2, y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.classList.add('theme-vt');
    const t = (document as any).startViewTransition(apply);
    t.ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 700, easing: 'cubic-bezier(.65,0,.25,1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
    t.finished.finally(() => root.classList.remove('theme-vt'));
  }
  buttons.forEach((b) => b.addEventListener('click', () => { setTheme(b.dataset.themeChoice!, b); if (pop) pop.open = false; }));
  group?.addEventListener('keydown', (e) => {
    if (!['ArrowRight', 'ArrowLeft'].includes(e.key)) return;
    const inline = Array.from(group.querySelectorAll<HTMLButtonElement>('button'));
    const i = inline.findIndex((b) => b.dataset.themeChoice === root.dataset.theme);
    const n = inline[(i + (e.key === 'ArrowRight' ? 1 : inline.length - 1)) % inline.length];
    n.focus(); setTheme(n.dataset.themeChoice!, n);
  });
  document.addEventListener('click', (e) => { if (pop?.open && !pop.contains(e.target as Node)) pop.open = false; });
</script>
