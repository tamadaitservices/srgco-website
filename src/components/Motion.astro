---
// Scroll-reveal + count-up. Classes are added by JS only, so content is fully visible without JS.
---
<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced && 'IntersectionObserver' in window) {
    const targets = Array.from(
      document.querySelectorAll<HTMLElement>(
        [
          'main h1', 'main h2', 'main .label:not(td .label)',
          'main section > p', 'main section > nav', 'main .btn', 'main .box',
          'main .ltable tbody tr', 'main details', 'main section ul > li', 'main section ol > li',
          '.nv-card', '.nv-row', '.nv-cells li', '.nv-lead', '.nv-body', '.nv-chips',
          '.cl-card', '.cl-time li', '.cl-prom', '.cl-office', '.cl-pills li', '.cl-stats', '.cl-panel', '.cl-faq details',
        ].join(','),
      ),
    ).filter((el) => !el.closest('#srg-widget') && !el.closest('td') && !el.closest('.nv-hero') && !el.closest('.nv-stats') && !el.closest('.cl-hero'));

    // underline-draw for italic words in editorial headings + eyebrow rules
    const marks = Array.from(document.querySelectorAll<HTMLElement>('.nv-h2, .nv-eyebrow'));
    marks.forEach((m) => m.classList.add('u-pre'));
    const mo = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { (e.target as HTMLElement).classList.remove('u-pre'); mo.unobserve(e.target); }
    }, { threshold: 0.4 });
    marks.forEach((m) => mo.observe(m));

    for (const el of targets) el.classList.add(el.tagName === 'TR' ? 'js-fade' : 'js-reveal');

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        visible.forEach((e, i) => {
          const el = e.target as HTMLElement;
          el.style.setProperty('--d', `${Math.min(i, 6) * 90}ms`);
          requestAnimationFrame(() => el.classList.add('in'));
          io.unobserve(el);
          // free the element for its own hover transitions once revealed
          setTimeout(() => {
            el.classList.remove('js-reveal', 'js-fade', 'in');
            el.style.removeProperty('--d');
          }, 1300 + i * 90);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    targets.forEach((el) => io.observe(el));

    // count-up numbers
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    const co = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        co.unobserve(el);
        const to = Number(el.dataset.count);
        const suffix = el.dataset.suffix || '';
        const start = performance.now();
        const tick = (t: number) => {
          const p = Math.min((t - start) / 1400, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(to * eased) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        el.textContent = '0' + suffix;
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    counters.forEach((c) => co.observe(c));
  }
</script>
