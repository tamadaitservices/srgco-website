---
import { services, firm } from '../data/site';
const topics = [...services.map((s) => s.title), 'Something else'];
const wa = (import.meta.env.PUBLIC_WHATSAPP || (import.meta.env.DEV ? '910000000000' : '')).replace(/\D/g, '');
const waText = encodeURIComponent(`Hello ${firm.name}, I would like to enquire about your services.`);
---
<div id="srg-widget" data-topics={JSON.stringify(topics)} data-wa={wa}>
  <!-- Floating buttons -->
  <div class="fab-stack">
    {wa && (
      <a class="fab wa" href={`https://wa.me/${wa}?text=${waText}`} target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 00-8.1 14.4L2.6 21.4l4.6-1.2A9.5 9.5 0 1012 2.5z"/><path d="M8.7 7.8c.3-.4.7-.4 1 0l.9 1.6c.2.4.1.7-.2 1l-.6.6c.7 1.4 1.800 2.500 3.200 3.200l.7-.7c.3-.3.7-.3 1 0l1.500.9c.4.2.4.7.1 1-.9 1-2 1.300-3.200.8-2.600-1.100-4.400-3-5.300-5.400-.3-1 .2-2 .9-3z"/></svg>
        <span class="fab-label">WhatsApp</span>
      </a>
    )}
    <button class="fab chat" id="srg-open" type="button" aria-haspopup="dialog" aria-controls="srg-panel" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h36v26H22l-10 8v-8H6z M14 18h20M14 25h12"/></svg>
      <span class="fab-label">Enquire</span>
    </button>
  </div>

  <!-- Panel -->
  <section id="srg-panel" class="panel" role="dialog" aria-label="Enquiry assistant" aria-modal="false" hidden>
    <header class="panel-head">
      <div>
        <p class="label">Enquiry desk</p>
        <p class="panel-title">S.R. Garimella &amp; Co.</p>
      </div>
      <button type="button" id="srg-close" class="close" aria-label="Close chat">✕</button>
    </header>
    <div id="srg-log" class="log" role="log" aria-live="polite"></div>
    <div id="srg-chips" class="chips"></div>
    <form id="srg-form" class="inputrow" autocomplete="off" novalidate>
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      <input id="srg-input" class="input" type="text" aria-label="Your answer" />
      <button type="submit" class="send">Send</button>
    </form>
    <p class="fine">Your details are sent only to the firm so we can respond to you.</p>
  </section>
</div>

<style is:global>
  #srg-widget { font-family: var(--font-serif); }
  #srg-widget .fab-stack { position: fixed; right: 1rem; bottom: 1rem; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: .6rem; }
  #srg-widget .fab { display: inline-flex; align-items: center; gap: .6rem; padding: .8rem 1.1rem; border: 1px solid var(--color-ink); cursor: pointer; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; box-shadow: 3px 3px 0 rgba(20,23,31,.18); transition: transform .15s; }
  #srg-widget .fab:hover { transform: translate(-1px,-1px); }
  #srg-widget .fab.chat { background: var(--color-ink); color: var(--color-paper); }
  #srg-widget .fab.wa { background: #1fa855; border-color: #14803f; color: #fff; }
  #srg-widget .panel { position: fixed; right: 1rem; bottom: 8.4rem; z-index: 61; width: min(24rem, calc(100vw - 2rem)); max-height: min(36rem, calc(100vh - 10rem)); display: flex; flex-direction: column; background: var(--color-paper); border: 3px double var(--color-ink); box-shadow: 6px 6px 0 rgba(20,23,31,.18); }
  #srg-widget .panel[hidden] { display: none; }
  #srg-widget .panel-head { display: flex; justify-content: space-between; align-items: flex-start; padding: .8rem 1rem; border-bottom: 1px solid var(--color-ink); background: var(--color-paper-deep); }
  #srg-widget .panel-title { font-size: 1.15rem; font-weight: 600; color: var(--color-pen); line-height: 1.2; }
  #srg-widget .close { font-family: var(--font-mono); background: none; border: 0; cursor: pointer; color: var(--color-ink); padding: .25rem .4rem; }
  #srg-widget .log { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: .7rem; background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 1.9rem, var(--color-rule-line) 1.9rem, var(--color-rule-line) calc(1.9rem + 1px)); }
  #srg-widget .msg { max-width: 88%; padding: .55rem .8rem; font-size: 1rem; line-height: 1.45; }
  #srg-widget .msg.bot { align-self: flex-start; background: var(--color-surface-solid); border: 1px solid var(--color-rule); color: var(--color-ink); }
  #srg-widget .msg.user { align-self: flex-end; background: var(--color-ink); color: var(--color-paper); }
  #srg-widget .msg.err { align-self: flex-start; color: var(--color-stamp); border: 1px solid var(--color-stamp); background: var(--color-surface-solid); }
  #srg-widget .msg a { text-decoration: underline; }
  #srg-widget .chips { display: flex; flex-wrap: wrap; gap: .4rem; padding: .5rem 1rem 0; max-height: 9.5rem; overflow-y: auto; }
  #srg-widget .chips:empty { display: none; }
  #srg-widget .chip { font-family: var(--font-serif); font-size: .92rem; padding: .3rem .7rem; border: 1px solid var(--color-ink); background: var(--color-surface-solid); color: var(--color-ink); cursor: pointer; }
  #srg-widget .chip:hover { background: var(--color-wash); }
  #srg-widget .inputrow { display: flex; gap: .5rem; padding: .7rem 1rem .4rem; }
  #srg-widget .inputrow[hidden] { display: none; }
  #srg-widget .hp { position: absolute; left: -9999px; }
  #srg-widget .input { flex: 1; min-width: 0; border: 0; border-bottom: 1px solid var(--color-ink); background: transparent; font-size: 1.05rem; font-family: var(--font-serif); padding: .35rem 0; }
  #srg-widget .input:focus { outline: none; border-bottom-width: 2px; background: var(--color-wash); }
  #srg-widget .send { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; background: var(--color-ink); color: var(--color-paper); border: 0; padding: .45rem .9rem; cursor: pointer; }
  #srg-widget .fine { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .04em; color: var(--color-ink-soft); padding: 0 1rem .7rem; }
  @media (max-width: 480px) { #srg-widget .fab-label { display: none; } #srg-widget .fab { padding: .85rem; } }
  @media (prefers-reduced-motion: reduce) { #srg-widget .fab { transition: none; } }
</style>

<script>
  const root = document.getElementById('srg-widget') as HTMLElement;
  const topics: string[] = JSON.parse(root.dataset.topics || '[]');
  const wa = root.dataset.wa || '';
  const panel = document.getElementById('srg-panel') as HTMLElement;
  const openBtn = document.getElementById('srg-open') as HTMLButtonElement;
  const closeBtn = document.getElementById('srg-close') as HTMLButtonElement;
  const log = document.getElementById('srg-log') as HTMLElement;
  const chips = document.getElementById('srg-chips') as HTMLElement;
  const form = document.getElementById('srg-form') as HTMLFormElement;
  const input = document.getElementById('srg-input') as HTMLInputElement;

  type Step = {
    key: string;
    ask: string;
    chips?: string[];
    inputType?: string;
    optional?: boolean;
    placeholder?: string;
    validate?: (v: string) => string | null;
  };
  const steps: Step[] = [
    { key: 'topic', ask: 'Welcome! What can we help you with?', chips: topics },
    { key: 'name', ask: 'May I have your name?', placeholder: 'Your full name', validate: (v) => (v.length < 2 ? 'Please enter your name.' : null) },
    {
      key: 'phone',
      ask: 'Your mobile number, so the team can call you back?',
      inputType: 'tel',
      placeholder: '+91 98xxxxxxxx',
      validate: (v) => {
        const d = v.replace(/\D/g, '');
        return d.length < 10 || d.length > 13 ? 'Please enter a valid phone number.' : null;
      },
    },
    {
      key: 'email',
      ask: 'And your email address? (optional)',
      inputType: 'email',
      optional: true,
      placeholder: 'you@company.com',
      validate: (v) => (v && !/^\S+@\S+\.\S+$/.test(v) ? 'That email does not look right.' : null),
    },
    { key: 'city', ask: 'Which city are you based in?', chips: ['Hyderabad', 'Vijayawada', 'Rajahmundry', 'Kakinada', 'Other'], placeholder: 'City' },
    { key: 'message', ask: 'Anything you would like us to know before we call? (optional)', optional: true, placeholder: 'A line or two about your requirement' },
  ];

  const data: Record<string, string> = {};
  let idx = -1;
  let started = false;
  let done = false;

  const el = (cls: string, text: string) => {
    const d = document.createElement('div');
    d.className = `msg ${cls}`;
    d.textContent = text;
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
    return d;
  };
  const bot = (t: string) => el('bot', t);

  function renderStep() {
    const s = steps[idx];
    chips.innerHTML = '';
    bot(s.ask);
    input.value = '';
    input.type = s.inputType || 'text';
    input.placeholder = s.placeholder || 'Type your answer';
    const opts = [...(s.chips || [])];
    if (s.optional) opts.push('Skip');
    for (const o of opts) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'chip';
      b.textContent = o;
      b.addEventListener('click', () => answer(o === 'Skip' ? '' : o, o));
      chips.appendChild(b);
    }
    form.hidden = false;
    // On mobile, avoid yanking the keyboard up for chip-only questions
    if (!s.chips) input.focus();
  }

  function answer(value: string, shown?: string) {
    if (done) return;
    const s = steps[idx];
    value = value.trim();
    if (!value && !s.optional) return;
    const err = s.validate?.(value);
    if (err) {
      el('err', err);
      return;
    }
    el('user', shown ?? (value || 'Skipped'));
    data[s.key] = value;
    chips.innerHTML = '';
    idx++;
    if (idx < steps.length) setTimeout(renderStep, 250);
    else submit();
  }

  function waLink() {
    const text = encodeURIComponent(
      `Hello S.R. Garimella & Co., I am ${data.name || ''}. I would like to enquire about: ${data.topic || 'your services'}.`,
    );
    return `https://wa.me/${wa}?text=${text}`;
  }

  async function submit() {
    form.hidden = true;
    const wait = bot('Sending your details to the team…');
    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...data, page: location.pathname, website: (form.elements.namedItem('website') as HTMLInputElement).value }),
      });
      wait.remove();
      if (res.ok) {
        done = true;
        bot(`Thank you, ${data.name}. Your enquiry has been shared with our team, and we will get back to you shortly.`);
        if (wa) {
          const m = bot('Prefer to continue on WhatsApp? ');
          const a = document.createElement('a');
          a.href = waLink();
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = 'Message us on WhatsApp →';
          m.appendChild(a);
        }
      } else {
        el('err', 'Sorry, we could not send that just now. Please call us or use the contact page.');
        if (wa) {
          const m = bot('You can also reach us here: ');
          const a = document.createElement('a');
          a.href = waLink();
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = 'WhatsApp →';
          m.appendChild(a);
        }
      }
    } catch {
      wait.remove();
      el('err', 'Network problem. Please try again, or call us directly.');
    }
  }

  function open() {
    panel.hidden = false;
    openBtn.setAttribute('aria-expanded', 'true');
    if (!started) {
      started = true;
      idx = 0;
      renderStep();
    } else if (!done) input.focus();
  }
  function close() {
    panel.hidden = true;
    openBtn.setAttribute('aria-expanded', 'false');
    openBtn.focus();
  }

  openBtn.addEventListener('click', () => (panel.hidden ? open() : close()));
  closeBtn.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) close();
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    answer(input.value);
  });
</script>
