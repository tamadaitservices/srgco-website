    // ---- Security ----
    const pwForm = $<HTMLFormElement>('#f-pw')!, pwMsg = $('#pw-msg')!, meter = $('#meter')!, meterL = $('#meter-l')!;
    const strength = (p: string) => Math.min(4, (p.length >= 8 ? 1 : 0) + (p.length >= 12 ? 1 : 0) + (/[A-Z]/.test(p) && /[a-z]/.test(p) ? 1 : 0) + (/\d/.test(p) && /[^A-Za-z0-9]/.test(p) ? 1 : 0));
    pwForm.addEventListener('input', () => {
      const v = (pwForm.elements.namedItem('next') as HTMLInputElement).value, s = strength(v);
      meter.style.width = (v ? Math.max(s, 1) * 25 : 0) + '%'; meter.style.background = ['#d92d20', '#d92d20', '#f79009', '#12b76a', '#138808'][s];
      meterL.textContent = !v ? 'Use at least 8 characters' : ['Too weak', 'Weak', 'Fair', 'Good', 'Strong'][s];
    });
    pwForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const g = (n: string) => (pwForm.elements.namedItem(n) as HTMLInputElement).value;
      const m = (t: string, k = '') => { pwMsg.textContent = t; pwMsg.className = 'ad-msg ' + k; };
      if (g('next') !== g('again')) return m('The two new passwords do not match.', 'err');
      m('Updating…');
      const r = await post('/api/admin/password', { current: g('current'), next: g('next') });
      if (r.ok) { m('Password updated. You stay signed in on this device.', 'ok'); note('Password updated', 'ok'); pwForm.reset(); meter.style.width = '0'; meterL.textContent = 'Use at least 8 characters'; } else m(r.j.error || 'Could not update.', 'err');
    });

    // ---- Save (About or Appearance) ----
    $('#save')!.addEventListener('click', async () => {
      const btn = $<HTMLButtonElement>('#save')!; btn.disabled = true;
      let r;
      if (tab === 'look') r = await post('/api/admin/settings', cfg, 'PUT');
      else if (tab === 'offices') { collectOffices(); r = await post('/api/admin/content', { offices }, 'PUT'); if (r.ok) { offices = r.j.offices; renderOffices(); } }
      else if (tab === 'services') { collectServices(); r = await post('/api/admin/content', { services }, 'PUT'); if (r.ok) { services = r.j.services; renderServices(); } }
      else { collect(); r = await post('/api/admin/about', about, 'PUT'); }
      btn.disabled = false;
      if (r.ok) { setDirty(false); note(tab === 'look' ? 'Saved. Visitors will see the new theme options shortly.' : tab === 'about' ? 'Saved. The About page is updated.' : 'Saved. The website is updated.', 'ok'); }
      else note(r.j.error || 'Could not save.', 'err');
      if (r.status === 401) setTimeout(() => (location.href = '/admin'), 1200);
    });

    // ---- load data ----
    go(Object.keys(TITLES).includes(location.hash.slice(1)) ? location.hash.slice(1) : 'home');
    Promise.all([
      fetch('/api/admin/about').then((r) => r.json()).then((d) => { about = d; renderAbout(); }).catch(() => (box.textContent = 'Could not load the content.')),
      fetch('/api/admin/settings').then((r) => r.json()).then((d) => { cfg = d; renderThemes(); }).catch(() => (tbox.textContent = 'Could not load the settings.')),
    ]).then(() => { if (tab === 'home') renderHome(); });
    fetch('/api/admin/content').then((r) => r.json()).then((d) => { offices = d.offices; services = d.services; icons = d.icons; renderOffices(); renderServices(); if (tab === 'home') renderHome(); }).catch(() => { obox.textContent = 'Could not load.'; sbox.textContent = 'Could not load.'; });
    fetch('/api/admin/status').then((r) => r.json()).then((d) => { health = d; if (tab === 'home') renderHome(); }).catch(() => {});
  }
</script>
