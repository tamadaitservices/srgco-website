---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminFlag from '../components/AdminFlag.astro';
import { adminEmail, adminEnabled, isAuthed, validResetToken } from '../lib/admin';

export const prerender = false;
const enabled = adminEnabled();
const authed = isAuthed(Astro.request);
const resetTok = Astro.url.searchParams.get('reset') || '';
const resetOk = enabled && !authed && validResetToken(resetTok);
const email = adminEmail();
const dots = Array.from({ length: 16 }, (_, i) => ({ l: (i * 37) % 100, d: 9 + ((i * 7) % 9), s: (i * 1.3) % 8 }));
const chakra = Array.from({ length: 24 }, (_, i) => i * 15);
---
<AdminLayout title="Admin">
  {!enabled && (
    <div class="ad-off">
      <div class="ad-strip" style="margin-bottom:2rem"></div>
      <h1 class="ad-h">Admin is switched off</h1>
      <p class="ad-sub">Set the <b>ADMIN_EMAIL</b> and <b>ADMIN_PASSWORD</b> environment variables on the server to turn it on.</p>
    </div>
  )}

  {enabled && !authed && (
    <main class="ad-auth" id="auth" data-view={resetOk ? 'reset' : 'login'} data-token={resetOk ? resetTok : ''}>
      <section class="ad-hero">
        <div class="ad-dots" aria-hidden="true">{dots.map((d) => <i style={`left:${d.l}%;bottom:-10px;animation-duration:${d.d}s;animation-delay:${d.s}s`}></i>)}</div>
        <div class="ad-hero-inner">
          <AdminFlag />
          <h1>S.R. Garimella &amp; Co.,<br /><span>Admin Console</span></h1>
          <p>Manage your website content, appearance and security from one place.</p>
        </div>
      </section>

      <section class="ad-panel">
        <div class="ad-card" id="card">
          <div class="ad-brand">
            <span class="ad-badge" aria-hidden="true"><svg viewBox="-30 -30 60 60"><circle r="26" fill="#fff" stroke="#000080" stroke-width="3" /><circle r="4" fill="#000080" />{chakra.map((a) => <line y1="-5" y2="-24" stroke="#000080" stroke-width="1.4" transform={`rotate(${a})`} />)}</svg></span>
            <div><b>Administrator</b><small>Secure sign-in</small></div>
          </div>

          <form id="f-login" data-v="login" novalidate>
            <h2>Welcome back</h2>
            <p class="ad-sub">Sign in to manage the website.</p>
            <label class="ad-field"><span>Email</span><input class="ad-in" type="email" name="email" autocomplete="username" required /></label>
            <label class="ad-field"><span>Password</span><span class="ad-pw"><input class="ad-in" type="password" name="password" autocomplete="current-password" required /><button type="button" class="ad-eye" data-eye>Show</button></span></label>
            <button class="ad-btn block" type="submit">Sign in <span aria-hidden="true">→</span></button>
            <p class="ad-msg" role="status"></p>
            <p class="ad-row"><button type="button" class="ad-linkbtn" data-go="forgot">Forgot password?</button><a href="/">← Back to website</a></p>
          </form>

          <form id="f-forgot" data-v="forgot" novalidate hidden>
            <h2>Reset your password</h2>
            <p class="ad-sub">Enter the administrator email. We will send a reset link, valid for 30 minutes.</p>
            <label class="ad-field"><span>Email</span><input class="ad-in" type="email" name="email" autocomplete="username" required /></label>
            <button class="ad-btn block" type="submit">Email me a reset link</button>
            <p class="ad-msg" role="status"></p>
            <p class="ad-row"><button type="button" class="ad-linkbtn" data-go="login">← Back to sign in</button></p>
          </form>

          <form id="f-reset" data-v="reset" novalidate hidden>
            <h2>Choose a new password</h2>
            <p class="ad-sub">Use at least 8 characters.</p>
            <label class="ad-field"><span>New password</span><span class="ad-pw"><input class="ad-in" type="password" name="password" autocomplete="new-password" required /><button type="button" class="ad-eye" data-eye>Show</button></span></label>
            <label class="ad-field"><span>Confirm password</span><input class="ad-in" type="password" name="again" autocomplete="new-password" required /></label>
            <button class="ad-btn block" type="submit">Save and sign in</button>
            <p class="ad-msg" role="status"></p>
          </form>
        </div>
      </section>
    </main>
  )}

  {enabled && authed && (
    <div id="app" class="ad-app">
      <div class="ad-strip-top"></div>
      <aside class="ad-side">
        <div class="ad-brand">
          <span class="ad-badge" aria-hidden="true"><svg viewBox="-30 -30 60 60"><circle r="26" fill="#fff" stroke="#000080" stroke-width="3" /><circle r="4" fill="#000080" />{chakra.map((a) => <line y1="-5" y2="-24" stroke="#000080" stroke-width="1.4" transform={`rotate(${a})`} />)}</svg></span>
          <div><b>S.R. Garimella &amp; Co.,</b><small>Admin Console</small></div>
        </div>
        <p class="ad-nav-lab">Menu</p>
        <nav class="ad-nav" role="tablist" aria-label="Admin sections">
          <button role="tab" aria-selected="true" data-tab="home"><span class="ni"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z" /></svg></span>Overview</button>
          <button role="tab" aria-selected="false" data-tab="about"><span class="ni"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h5" /></svg></span>About page</button>
          <button role="tab" aria-selected="false" data-tab="offices"><span class="ni"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6-7-11a7 7 0 0114 0c0 5-7 11-7 11zM12 7.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5z" /></svg></span>Offices &amp; phones</button>
          <button role="tab" aria-selected="false" data-tab="services"><span class="ni"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h18v12H3zM8 8V5h8v3M3 13h18" /></svg></span>Services</button>
          <button role="tab" aria-selected="false" data-tab="look"><span class="ni"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 100 18c1.5 0 2-1 1.5-2s0-2 1.5-2h2A4 4 0 0021 10c0-4-4-7-9-7zM7.5 11h.01M10 7.5h.01M14 7.5h.01" /></svg></span>Appearance</button>
          <button role="tab" aria-selected="false" data-tab="security"><span class="ni"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" /><path d="M9 12l2 2 4-4" /></svg></span>Security</button>
        </nav>
        <div class="ad-short">
          <p class="ad-nav-lab2">View on website</p>
          <a href="/about" target="_blank" rel="noopener">About us <i>↗</i></a>
          <a href="/services" target="_blank" rel="noopener">Services <i>↗</i></a>
          <a href="/industries" target="_blank" rel="noopener">Industries <i>↗</i></a>
          <a href="/insights" target="_blank" rel="noopener">Notes <i>↗</i></a>
          <a href="/contact" target="_blank" rel="noopener">Contact <i>↗</i></a>
        </div>
        <div class="ad-tip"><b>Tip</b><span>After you press <b>Save</b>, open the page on the website to check how it looks.</span></div>
        <div class="ad-side-foot">
          <div class="ad-me"><span class="ad-av" aria-hidden="true">{email.charAt(0) || 'A'}</span><div><b>Administrator</b><span title={email}>{email}</span></div></div>
          <div class="ad-foot-btns"><a class="ad-btn ghost sm" href="/" target="_blank" rel="noopener">View site</a><button class="ad-btn ghost sm" type="button" id="logout">Sign out</button></div>
        </div>
      </aside>

      <div class="ad-main">
        <div class="ad-mhead"><span class="ad-badge" aria-hidden="true"><svg viewBox="-30 -30 60 60"><circle r="26" fill="#fff" stroke="#000080" stroke-width="3" /><circle r="4" fill="#000080" />{chakra.map((a) => <line y1="-5" y2="-24" stroke="#000080" stroke-width="1.4" transform={`rotate(${a})`} />)}</svg></span><b>S.R. Garimella &amp; Co.,</b><button class="ad-btn ghost sm" type="button" id="logout-m" style="margin-left:auto">Sign out</button></div>
        <header class="ad-head">
          <div><p class="ad-crumb">Admin / <b id="crumb">Overview</b></p><h1 class="ad-title" id="title">Overview</h1></div>
        </header>

        <main class="ad-content">
          <section class="ad-view" data-panel="home">
            <div class="ad-welcome"><h2 id="greet">Welcome</h2><p>Use the menu to update your website. Edit the About page, choose the colour themes visitors can use, or change your password.</p></div>
            <div class="ad-stats" id="stats"></div>
            <h2 class="ad-h2">Quick actions</h2>
            <div class="ad-quick">
              <button type="button" class="ad-q" data-goto="about"><b>Edit About page <i>→</i></b><span>Founders, photos, timeline, values and promise.</span></button>
              <button type="button" class="ad-q" data-goto="offices"><b>Offices &amp; phones <i>→</i></b><span>Addresses, mobile numbers and map locations.</span></button>
              <button type="button" class="ad-q" data-goto="services"><b>Services <i>→</i></b><span>Add, edit or reorder your services.</span></button>
              <button type="button" class="ad-q" data-goto="look"><b>Manage themes <i>→</i></b><span>Turn themes on or off and pick the default.</span></button>
              <button type="button" class="ad-q" data-goto="security"><b>Change password <i>→</i></b><span>Keep your admin account safe.</span></button>
            </div>
            <h2 class="ad-h2">System health</h2>
            <div class="ad-health" id="health"><div class="ad-hrow"><span class="ad-dot"></span><div><b>Checking…</b></div></div></div>
          </section>

          <section class="ad-view" data-panel="about" hidden>
            <p class="ad-lead">Edit what visitors see on the About page. Changes go live when you press Save.</p>
            <div id="about-fields"><p class="ad-lead">Loading…</p></div>
          </section>

          <section class="ad-view" data-panel="offices" hidden>
            <p class="ad-lead">Edit each office's address, phone numbers, email and map location. These appear in the footer, contact page, home page, About page map and each city page.</p>
            <div id="office-fields"><p class="ad-lead">Loading…</p></div>
          </section>

          <section class="ad-view" data-panel="services" hidden>
            <p class="ad-lead">Add, edit, reorder or remove services. Each service gets its own page on the website, and appears in the menu lists, footer and enquiry forms.</p>
            <div id="service-fields"><p class="ad-lead">Loading…</p></div>
          </section>

          <section class="ad-view" data-panel="look" hidden>
            <p class="ad-lead">Choose which colour themes visitors can pick from, and which one new visitors see first. A theme that is switched off is removed from the website's theme switcher.</p>
            <div id="theme-fields" class="ad-themes"></div>
          </section>

          <section class="ad-view" data-panel="security" hidden>
            <p class="ad-lead">Signed in as <b>{email}</b>.</p>
            <div class="ad-secgrid">
              <form class="ad-sec" id="f-pw" novalidate>
                <h3><span class="ad-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 018 0v3" /></svg></span>Change password</h3>
                <label class="ad-field"><span>Current password</span><input class="ad-in" type="password" name="current" autocomplete="current-password" /></label>
                <label class="ad-field"><span>New password</span><span class="ad-pw"><input class="ad-in" type="password" name="next" autocomplete="new-password" /><button type="button" class="ad-eye" data-eye>Show</button></span><span class="ad-meter"><i id="meter"></i></span><span class="ad-meter-l" id="meter-l">Use at least 8 characters</span></label>
                <label class="ad-field"><span>Confirm new password</span><input class="ad-in" type="password" name="again" autocomplete="new-password" /></label>
                <button class="ad-btn" type="submit" style="margin-top:1.3rem">Update password</button>
                <p class="ad-msg" role="status" id="pw-msg"></p>
              </form>
              <div class="ad-sec">
                <h3><span class="ad-ico g"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" /><path d="M9 12l2 2 4-4" /></svg></span>Good to know</h3>
                <ul class="ad-tips">
                  <li>Use a long password you do not use anywhere else.</li>
                  <li>Forgot it? On the sign-in page choose “Forgot password?” and a reset link is emailed to {email}.</li>
                  <li>Your password is stored as a salted hash, never as plain text.</li>
                  <li>Changing it signs out all other devices.</li>
                </ul>
              </div>
            </div>
          </section>
        </main>
      </div>

      <div class="ad-save hide" id="bar"><span id="save-state">All changes saved</span><button class="ad-btn" type="button" id="save">Save changes</button></div>
      <div class="ad-toasts" id="toasts" aria-live="polite"></div>
    </div>
  )}
</AdminLayout>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T | null;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const post = async (url: string, body: unknown, method = 'POST') => {
    const r = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    return { ok: r.ok, status: r.status, j: (await r.json().catch(() => ({}))) as any };
  };
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-eye]');
    if (!b) return;
    const inp = b.parentElement!.querySelector('input')!;
    inp.type = inp.type === 'password' ? 'text' : 'password';
    b.textContent = inp.type === 'password' ? 'Show' : 'Hide';
  });

  // =============== signed-out screens ===============
  const auth = $('#auth');
  if (auth) {
    const show = (v: string) => {
      auth.dataset.view = v;
      auth.querySelectorAll<HTMLFormElement>('form[data-v]').forEach((f) => { f.hidden = f.dataset.v !== v; f.querySelector<HTMLElement>('.ad-msg')!.textContent = ''; });
      $('input', $(`form[data-v="${v}"]`, auth)!)?.focus();
    };
    show(auth.dataset.view || 'login');
    auth.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => show(b.dataset.go!)));
    const say = (f: HTMLElement, t: string, kind = '') => {
      const m = $('.ad-msg', f)!; m.textContent = t; m.className = 'ad-msg ' + kind;
      if (kind === 'err') { const c = $('#card')!; c.classList.remove('ad-shake'); void c.offsetWidth; c.classList.add('ad-shake'); }
    };
    const enter = () => { auth.classList.add('leaving'); setTimeout(() => (location.href = '/admin'), 700); };
    const val = (f: HTMLFormElement, n: string) => (f.elements.namedItem(n) as HTMLInputElement).value;

    $<HTMLFormElement>('#f-login')!.addEventListener('submit', async (e) => {
      e.preventDefault(); const f = e.target as HTMLFormElement; const btn = $<HTMLButtonElement>('button[type=submit]', f)!;
      btn.disabled = true; say(f, 'Signing in…');
      const r = await post('/api/admin/login', { email: val(f, 'email'), password: val(f, 'password') });
      btn.disabled = false;
      if (r.ok) { say(f, 'Welcome!', 'ok'); enter(); } else say(f, r.j.error || 'Could not sign in.', 'err');
    });
    $<HTMLFormElement>('#f-forgot')!.addEventListener('submit', async (e) => {
      e.preventDefault(); const f = e.target as HTMLFormElement; const btn = $<HTMLButtonElement>('button[type=submit]', f)!;
      btn.disabled = true; say(f, 'Sending…');
      const r = await post('/api/admin/forgot', { email: val(f, 'email') });
      btn.disabled = false; say(f, r.ok ? r.j.message : r.j.error || 'Could not send.', r.ok ? 'ok' : 'err');
    });
    $<HTMLFormElement>('#f-reset')!.addEventListener('submit', async (e) => {
      e.preventDefault(); const f = e.target as HTMLFormElement; const btn = $<HTMLButtonElement>('button[type=submit]', f)!;
      if (val(f, 'password') !== val(f, 'again')) return say(f, 'The two passwords do not match.', 'err');
      btn.disabled = true; say(f, 'Saving…');
      const r = await post('/api/admin/reset', { token: auth.dataset.token, password: val(f, 'password') });
      btn.disabled = false;
      if (r.ok) { say(f, 'Password updated.', 'ok'); enter(); } else say(f, r.j.error || 'Could not reset.', 'err');
    });
  }

  // =============== signed-in dashboard ===============
  const app = $('#app');
  if (app) {
    const ic = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;
    const I = {
      user: 'M16 20v-1a4 4 0 00-4-4H8a4 4 0 00-4 4v1M10 11a3 3 0 100-6 3 3 0 000 6M20 20v-1a3 3 0 00-2-2.8M16 5.2a3 3 0 010 5.6',
      img: 'M4 5h16v14H4zM4 15l4-4 4 4 3-3 5 5M9 9h.01', clock: 'M12 3a9 9 0 100 18 9 9 0 000-18zM12 7v5l3 2', doc: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h5',
      heart: 'M12 21s-7-4.5-9.3-9A5 5 0 0112 6a5 5 0 019.3 6C19 16.5 12 21 12 21z', pal: 'M12 3a9 9 0 100 18c1.5 0 2-1 1.5-2s0-2 1.5-2h2A4 4 0 0021 10c0-4-4-7-9-7zM7.5 11h.01M10 7.5h.01M14 7.5h.01',
      plus: 'M12 5v14M5 12h14', pin: 'M12 21s-7-6-7-11a7 7 0 0114 0c0 5-7 11-7 11zM12 7.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5z', brief: 'M3 8h18v12H3zM8 8V5h8v3M3 13h18', trash: 'M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3', eye: 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 100 6 3 3 0 000-6',
    };
    const toasts = $('#toasts')!;
    const note = (t: string, kind = '', ms = 3600) => {
      if (!t) return;
      const el = document.createElement('div'); el.className = 'ad-t ' + kind; el.textContent = t; toasts.appendChild(el);
      while (toasts.children.length > 3) toasts.firstElementChild!.remove();
      setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 320); }, ms);
    };
    const signOut = async () => { await post('/api/admin/logout', {}); location.href = '/admin'; };
    $('#logout')!.addEventListener('click', signOut); $('#logout-m')?.addEventListener('click', signOut);

    // ---- unsaved-changes tracking ----
    let dirty = false;
    const bar = $('#bar')!, barState = $('#save-state')!;
    const setDirty = (v: boolean) => { dirty = v; bar.classList.toggle('dirty', v); barState.textContent = v ? 'You have unsaved changes' : 'All changes saved'; };
    addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });

    // ---- tabs ----
    const TITLES: Record<string, string> = { home: 'Overview', about: 'About page', offices: 'Offices & phones', services: 'Services', look: 'Appearance', security: 'Security' };
    let tab = 'home';
    const tabs = Array.from(app.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(app.querySelectorAll<HTMLElement>('[data-panel]'));
    const go = (t: string) => {
      tab = t;
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === t)));
      panels.forEach((p) => { const on = p.dataset.panel === t; p.hidden = !on; if (on) { p.style.animation = 'none'; void p.offsetWidth; p.style.animation = ''; } });
      $('#title')!.textContent = TITLES[t]; $('#crumb')!.textContent = TITLES[t];
      bar.classList.toggle('hide', !['about', 'look', 'offices', 'services'].includes(t));
      history.replaceState(null, '', '#' + t);
      scrollTo({ top: 0 });
      if (t === 'home') renderHome();
    };
    tabs.forEach((b) => b.addEventListener('click', () => go(b.dataset.tab!)));
    app.addEventListener('click', (e) => { const g = (e.target as HTMLElement).closest<HTMLElement>('[data-goto]'); if (g) go(g.dataset.goto!); });

    // ---- About editor ----
    type Founder = { name: string; role: string; bio: string; photo: string };
    type About = { description: string; approach: string; founders: Founder[]; photos: { src: string; caption: string }[]; timeline: { year: string; text: string }[]; values: string[]; promises: string[] };
    let about: About = { description: '', approach: '', founders: [], photos: [], timeline: [], values: [], promises: [] };
    const box = $('#about-fields')!;
    const initials = (n: string) => n.replace(/^(Late|Sri|Mr|Ms|Dr)\.?\s+/i, '').split(/[\s.]+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || '?';
    const head = (icon: string, cls: string, title: string, hint = '') => `<h3><span class="ad-ico ${cls}">${ic(icon)}</span>${title}</h3>${hint ? `<p class="ad-hint">${hint}</p>` : ''}`;
    function renderAbout() {
      box.innerHTML = `
        <div class="ad-sec">${head(I.doc, '', 'Introduction', 'The first paragraphs on the About page.')}
          <label class="ad-field"><span>About the firm</span><textarea class="ad-in" rows="4" data-k="description">${esc(about.description)}</textarea></label>
          <label class="ad-field"><span>Our approach</span><textarea class="ad-in" rows="3" data-k="approach">${esc(about.approach)}</textarea></label>
        </div>
        <div class="ad-sec">${head(I.user, 'o', 'Founders &amp; partners', 'Add a photo and a short description for each person.')}
          ${about.founders.map((f, i) => `
            <div class="ad-founder" data-list="founders" data-i="${i}">
              <div class="ad-fp ad-photo" data-i="${i}">
                ${f.photo ? `<img src="${esc(f.photo)}" alt="" />` : `<span class="ph">${esc(initials(f.name))}</span>`}
                <div><label class="ad-btn ghost sm">${f.photo ? 'Change photo' : 'Upload photo'}<input type="file" accept="image/jpeg,image/png,image/webp" hidden /></label>
                ${f.photo ? '<br /><button type="button" class="ad-linkbtn" data-act="rm-photo" style="font-size:.8rem">Remove photo</button>' : ''}</div>
              </div>
              <div class="ad-fd">
                <label class="ad-field"><span>Name</span><input class="ad-in" data-f="name" value="${esc(f.name)}" /></label>
                <label class="ad-field"><span>Role / qualifications</span><input class="ad-in" data-f="role" value="${esc(f.role)}" /></label>
                <label class="ad-field"><span>Details</span><textarea class="ad-in" rows="3" data-f="bio">${esc(f.bio)}</textarea></label>
              </div>
              <button type="button" class="ad-btn danger sm ad-rm" data-act="del">Remove</button>
            </div>`).join('')}
