    function collect() {
      box.querySelectorAll<HTMLTextAreaElement>('[data-k]').forEach((el) => {
        const k = el.dataset.k as 'description' | 'approach' | 'values' | 'promises';
        if (k === 'values' || k === 'promises') about[k] = el.value.split('\n').map((x) => x.trim()).filter(Boolean); else about[k] = el.value;
      });
      box.querySelectorAll<HTMLElement>('[data-list]').forEach((item) => {
        const row = (about as any)[item.dataset.list!][Number(item.dataset.i)];
        item.querySelectorAll<HTMLInputElement>('[data-f]').forEach((el) => { row[el.dataset.f!] = el.value; });
      });
