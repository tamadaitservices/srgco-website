---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NoteBanner from '../../components/NoteBanner.astro';
import { getServices } from '../../lib/content';
const services = getServices();

const notes = await getCollection('notes', ({ data }) => !data.draft);
const entry = notes.find((n) => n.id === Astro.params.slug);
if (!entry) return Astro.rewrite('/404');
const { Content } = await render(entry);
const d = entry.data;
const site = (Astro.site ?? new URL('https://srgco.in')).toString().replace(/\/$/, '');
const fmt = d.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const mins = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 200));
const service = services.find((s) => s.slug === d.service);
const ld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, datePublished: d.date.toISOString(), dateModified: d.date.toISOString(),
    author: { '@type': 'Organization', name: 'S.R. Garimella & Co.' }, publisher: { '@type': 'Organization', name: 'S.R. Garimella & Co.' }, mainEntityOfPage: `${site}/insights/${entry.id}` },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' }, { '@type': 'ListItem', position: 2, name: 'Notes', item: site + '/insights' }, { '@type': 'ListItem', position: 3, name: d.title } ] },
];
---
<Base title={d.title} description={d.description} ogType="article" jsonLd={ld}>
  <article class="mx-auto max-w-3xl px-5 pt-14">
    <nav class="label" aria-label="Breadcrumb"><a class="link" href="/insights">Notes</a> / {d.category}</nav>
    <div class="mt-5"><NoteBanner title={d.title} category={d.category} service={d.service} image={d.banner} size="hero" /></div>
    <h1 class="mt-6 !text-4xl md:!text-5xl">{d.title}</h1>
    <p class="label mt-4">{fmt} · {mins} min read</p>
    <div class="note-actions no-print">
      {d.pdf && <button type="button" class="btn" id="pdf-view" aria-expanded="false" aria-controls="pdf-panel">View PDF</button>}
      {d.pdf && <a class="btn ghost" href={d.pdf} download>Download PDF</a>}
      <button type="button" class="btn ghost" id="pdf-print">Save this note as PDF</button>
    </div>
    {d.pdf && (
      <div id="pdf-panel" class="pdf-panel no-print" hidden>
        <iframe title={`PDF: ${d.title}`} data-src={d.pdf}></iframe>
        <p class="tool-note">Cannot see the PDF? <a class="link" href={d.pdf} target="_blank" rel="noopener">Open it in a new tab</a>.</p>
      </div>
    )}
    <div class="prose"><Content /></div>
    <div class="tool-disclaimer">
      <p>This note is general information, not advice for your specific situation. Laws and rules change — please speak to us before acting.</p>
      <div class="tool-cta">
        {service && <a class="btn" href={`/services/${service.slug}`}>{service.title}</a>}
        <a class="btn ghost" href="/book">Book a call</a>
      </div>
    </div>
  </article>
</Base>

<script>
  const panel = document.getElementById('pdf-panel');
  const btn = document.getElementById('pdf-view');
  btn?.addEventListener('click', () => {
    if (!panel) return;
    const open = panel.hidden;
    panel.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Hide PDF' : 'View PDF';
    const f = panel.querySelector('iframe')!;
    if (open && !f.getAttribute('src')) f.setAttribute('src', f.dataset.src!);
  });
  document.getElementById('pdf-print')?.addEventListener('click', () => window.print());
</script>
