---
import ToolLayout from '../../layouts/ToolLayout.astro';
---
<ToolLayout
  title="GST Calculator — Add or Remove GST (CGST, SGST, IGST)"
  description="Free GST calculator: add GST to a price or remove it from a GST-inclusive amount, with the CGST, SGST and IGST split."
  h1="GST calculator"
  intro="Add GST to a price, or work backwards from a GST-inclusive amount. Choose within-state or inter-state to see the CGST / SGST / IGST split."
>
  <div class="tool-grid">
    <form id="gs-form" class="tool-card" onsubmit="return false" novalidate>
      <fieldset class="seg-wrap"><legend class="tool-lab">What do you want to do?</legend>
        <div class="seg">
          <label><input type="radio" name="mode" value="exclusive" checked /><span>Add GST</span></label>
          <label><input type="radio" name="mode" value="inclusive" /><span>Remove GST</span></label>
        </div>
      </fieldset>
      <label class="tool-f"><span class="tool-lab" id="gs-amt-lab">Amount before GST (₹)</span><input class="field" id="gs-amount" inputmode="numeric" value="10,000" autocomplete="off" /></label>
      <label class="tool-f"><span class="tool-lab">GST rate (%)</span>
        <input class="field" id="gs-rate" inputmode="decimal" value="18" autocomplete="off" />
        <span class="chips" id="gs-chips"><button type="button" data-r="5">5%</button><button type="button" data-r="12">12%</button><button type="button" data-r="18">18%</button><button type="button" data-r="28">28%</button></span>
      </label>
      <fieldset class="seg-wrap"><legend class="tool-lab">Type of supply</legend>
        <div class="seg">
          <label><input type="radio" name="supply" value="intra" checked /><span>Within the state (CGST + SGST)</span></label>
          <label><input type="radio" name="supply" value="inter" /><span>Between states (IGST)</span></label>
        </div>
      </fieldset>
      <p class="tool-note">Use the rate that applies to your goods or services — check the current GST rate notifications.</p>
    </form>
    <div class="tool-card tool-out" id="gs-out" aria-live="polite"></div>
  </div>
</ToolLayout>

<script>
  import { computeGst } from '../../lib/tax';
  import { inr, num, bindInr } from '../../lib/ui';
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const out = document.getElementById('gs-out')!;
  const val = (n: string) => (document.querySelector(`input[name=${n}]:checked`) as HTMLInputElement).value;
  function calc() {
    const mode = val('mode') as 'exclusive' | 'inclusive';
    document.getElementById('gs-amt-lab')!.textContent = mode === 'exclusive' ? 'Amount before GST (₹)' : 'Amount including GST (₹)';
    const rate = Math.min(100, Number($('gs-rate').value) || 0);
    const r = computeGst(num($('gs-amount')), rate, mode, val('supply') as 'intra' | 'inter');
    const split = r.igst > 0
      ? `<div><dt>IGST (${rate}%)</dt><dd>${inr(r.igst)}</dd></div>`
      : `<div><dt>CGST (${rate / 2}%)</dt><dd>${inr(r.cgst)}</dd></div><div><dt>SGST (${rate / 2}%)</dt><dd>${inr(r.sgst)}</dd></div>`;
    out.innerHTML = `
      <p class="label">Result</p>
      <p class="tool-big">${inr(mode === 'exclusive' ? r.total : r.base)}</p>
      <p class="tool-sub">${mode === 'exclusive' ? 'Total amount including GST' : 'Amount before GST'}</p>
      <dl class="tool-dl">
        <div><dt>Amount before GST</dt><dd>${inr(r.base)}</dd></div>
        <div><dt>Total GST (${rate}%)</dt><dd>${inr(r.gst)}</dd></div>
        ${split}
        <div class="sum"><dt>Amount including GST</dt><dd>${inr(r.total)}</dd></div>
      </dl>`;
  }
  bindInr($('gs-amount'), calc);
  $('gs-rate').addEventListener('input', calc);
  document.getElementById('gs-form')!.addEventListener('change', calc);
  document.getElementById('gs-chips')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    $('gs-rate').value = b.dataset.r!; calc();
  });
  calc();
</script>
