---
import Base from '../layouts/Base.astro';
import { firm, timeline, values, promises } from '../data/site';
---
<Base title="About" description="Learn about S.R. Garimella & Co., Chartered Accountants established in 1989 — our firm, approach, legacy and core values.">
  <section class="ledger">
    <div class="mx-auto max-w-4xl px-5 pb-20 pt-14 md:pl-24">
      <p class="label">Who we are</p>
      <h1 class="mt-3">About S.R. Garimella &amp; Co.</h1>
      <div class="mt-10 space-y-6 text-xl">
        <p>{firm.description}</p>
        <p>{firm.approach}</p>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-4xl px-5 pt-20">
    <p class="label">Our legacy</p>
    <table class="ltable mt-4">
      <thead><tr><th class="w-28">Year</th><th>Particulars</th></tr></thead>
      <tbody>{timeline.map((t) => <tr><td class="num text-xl text-pen">{t.year}</td><td class="text-xl">{t.text}</td></tr>)}</tbody>
    </table>
  </section>
  <section class="mx-auto grid max-w-4xl gap-12 px-5 pt-20 md:grid-cols-2">
    <div><h2>Core values</h2>
      <ul class="mt-6">{values.map((v) => <li class="border-b border-rule py-2 text-xl text-pen">{v.name}</li>)}</ul></div>
    <div><h2>Our promise</h2>
      <ol class="mt-6">{promises.map((p, i) => <li class="flex gap-3 border-b border-rule py-2 text-lg"><span class="num text-sm text-stamp">{String(i + 1).padStart(2, '0')}</span>{p}</li>)}</ol></div>
  </section>
</Base>
