---
import Base from '../layouts/Base.astro';
import { firm } from '../data/site';
import { getOffices, getServices, mapLinks, telHref as telHrefOf } from '../lib/content';

const offices = getOffices();
const services = getServices();
const o = offices.find((x) => x.slug === Astro.params.city);
if (!o) return Astro.rewrite('/404');
const ld = { '@context': 'https://schema.org', '@type': 'AccountingService', name: `${firm.name} — ${o.city}`, areaServed: o.city, address: { '@type': 'PostalAddress', addressLocality: o.city, addressRegion: o.region, addressCountry: 'IN' }, telephone: o.telHref || undefined, email: o.email || undefined };
---
<Base
  title={`Chartered Accountants in ${o.city}`}
  description={`S.R. Garimella & Co. — Chartered Accountants serving ${o.city}: audit, tax, GST, transfer pricing, corporate law and advisory.`}
  jsonLd={ld}
>
  <section class="ledger">
    <div class="mx-auto max-w-4xl px-5 pb-16 pt-12">
      <p class="label">{o.region}</p>
      <h1 class="mt-3 text-5xl md:text-7xl">Chartered Accountants in {o.city}</h1>
      <p class="mt-6 text-xl">{firm.name} has served businesses since {firm.established}. {o.primary ? `Visit our ${o.city} office or write to us.` : `We serve clients in ${o.city} — reach us through our other offices.`}</p>
      {o.primary && o.address.length > 0 && (
        <address class="mt-6 text-lg not-italic">
          {o.address?.map((l) => <span class="block">{l}</span>)}
          <span class="block">{o.city} – {o.postal}</span>
          {o.phones.map((p) => <a class="link block" href={`tel:${telHrefOf(p)}`}>{p}</a>)}
          {o.email && <a class="mail-btn mt-2" href={`mailto:${o.email}`}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg> Email us</a>} <a class="mail-btn mt-2" href={mapLinks(o).open} target="_blank" rel="noopener noreferrer"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6-7-11a7 7 0 0114 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg> View on map</a>
        </address>
      )}
    </div>
  </section>
  <section class="mx-auto max-w-4xl px-5 pt-14">
    <h2>Services in {o.city}</h2>
    <ul class="mt-6 space-y-2">
      {services.map((s) => <li><a class="link text-xl" href={`/services/${s.slug}`}>{s.title}</a></li>)}
    </ul>
  </section>
</Base>
