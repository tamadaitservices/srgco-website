---
import Base from '../layouts/Base.astro';
import { offices, services, firm } from '../data/site';

export function getStaticPaths() {
  return offices.map((o) => ({ params: { city: o.slug }, props: { o } }));
}
const { o } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'AccountingService', name: `${firm.name} — ${o.city}`, areaServed: o.city, address: { '@type': 'PostalAddress', addressLocality: o.city, addressRegion: o.region, addressCountry: 'IN' }, telephone: o.telHref, email: o.email };
---
<Base
  title={`Chartered Accountants in ${o.city}`}
  description={`S.R. Garimella & Co. — Chartered Accountants serving ${o.city}: audit, tax, GST, transfer pricing, corporate law and advisory.`}
  jsonLd={ld}
>
  <section class="ledger">
    <div class="mx-auto max-w-4xl px-5 pb-16 pt-12">
      <p class="label">{o.region}</p>
      <h1 class="mt-3 text-5xl md:text-7xl">Chartered Accountants in {o.city}</h1>
      <p class="mt-6 text-xl">{firm.name} has served businesses since {firm.established}. {o.primary ? `Visit our ${o.city} office or write to us.` : `We serve clients in ${o.city} — reach us through our Hyderabad or Vijayawada offices.`}</p>
      {o.primary && (
        <address class="mt-6 text-lg not-italic">
          {o.address?.map((l) => <span class="block">{l}</span>)}
          <span class="block">{o.city} – {o.postal}</span>
          <a class="link block" href={`tel:${o.telHref}`}>{o.tel}</a>
          <a class="link block" href={`mailto:${o.email}`}>{o.email}</a>
        </address>
      )}
    </div>
  </section>
  <section class="mx-auto max-w-4xl px-5 pt-14">
    <h2>Services in {o.city}</h2>
    <ul class="mt-6 space-y-2">
      {services.map((s) => <li><a class="link text-xl" href={`/services/${s.slug}`}>{s.title}</a></li>)}
    </ul>
  </section>
</Base>
