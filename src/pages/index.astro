---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mascot from '../components/Mascot.astro';
import { firm, services, values, promises, timeline, sectors, offices, enquiryTypes } from '../data/site';

const years = new Date().getFullYear() - firm.established;
const faq = [
  { q: 'Where are S.R. Garimella & Co. offices located?', a: 'We have offices in Hyderabad (Himayat Nagar) and Vijayawada (Veterinary Colony), and also serve clients in Rajahmundry and Kakinada.' },
  { q: 'What services do you provide?', a: 'Audit & assurance, direct tax advisory and litigation support, international taxation and transfer pricing, GST and customs, 100% EOU compliance, corporate law, corporate finance advisory, and accounting outsourcing.' },
  { q: 'Since when has the firm been practising?', a: 'The firm was established in 1989 by Late Sri Garimella Someswara Rao, FCA, and was reconstituted as a partnership firm in 2009.' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const roman = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii'];
---
<Base
  title="Chartered Accountants in Hyderabad & Vijayawada | S.R. Garimella & Co."
  description="S.R. Garimella & Co. — Chartered Accountants since 1989. Audit & assurance, direct and indirect tax, GST, transfer pricing, corporate law and advisory in Hyderabad, Vijayawada, Rajahmundry and Kakinada."
  jsonLd={faqLd}
>

  <!-- ============ Navy & Copper design (editorial) ============ -->
  <div class="nv-only">
    <section class="nv-hero">
      <div class="nv-wrap nv-meta" data-in style="--d:.05s">
        <span>SRG / 001</span>
        <span>Hyderabad · Vijayawada · 17.39° N · 78.49° E</span>
        <span>Est. MCMLXXXIX</span>
      </div>
      <div class="nv-wrap nv-hero-body">
        <div>
          <p class="nv-kicker label" data-in style="--d:.15s"><i></i>Chartered Accountants · Practising since {firm.established}</p>
          <h1 data-in style="--d:.25s">S.R. Garimella <em>&amp;</em> Co.</h1>
          <span class="nv-rule" aria-hidden="true"></span>
          <p class="nv-tag" data-in style="--d:.55s">Building trust through professional excellence.</p>
        </div>
        <div class="nv-hero-right" data-in style="--d:.7s">
          <p>{firm.description}</p>
          <a class="nv-btn solid" href="/contact">Schedule a consultation <span>→</span></a>
          <a class="nv-btn line" href="/services">Explore our services <span>→</span></a>
        </div>
        <div class="nv-scroll" aria-hidden="true"><b>SCROLL</b><i></i></div>
      </div>
      <ul class="nv-stats" aria-label="Firm at a glance" data-in style="--d:.9s">
        <li><strong>{firm.established}</strong><span>Established</span></li>
        <li><strong data-count={years}>{years}</strong><span>Years of practice</span></li>
        <li><strong data-count={services.length}>{services.length}</strong><span>Practice areas</span></li>
        <li><strong data-count="4">4</strong><span>Cities served</span></li>
      </ul>
    </section>

    <section class="band band-light nv-sec">
      <div class="nv-wrap nv-split">
        <div><p class="nv-eyebrow"><i></i>Who we are</p><p class="nv-secno">Section 01</p></div>
        <div>
          <h2 class="nv-h2">A firm built on <em>trust</em>, <em>competence</em> and the long view.</h2>
          <p class="nv-lead">{firm.description}</p>
          <p class="nv-body">{firm.approach}</p>
        </div>
      </div>
    </section>

    <section class="band band-dark nv-sec">
      <div class="nv-wrap">
        <p class="nv-eyebrow"><i></i>What we do</p>
        <h2 class="nv-h2 mt-6 max-w-4xl">Eight practice areas, <em>one</em> standard.</h2>
        <div class="nv-grid">
          {services.map((sv, k) => (
            <a class="nv-card" href={`/services/${sv.slug}`}>
              <Icon name={sv.icon} size={40} />
              <span class="fol">{String(k + 1).padStart(2, '0')} /</span>
              <h3>{sv.title}</h3>
              <p>{sv.short}</p>
              <span class="more">Read more →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="band band-light nv-sec">
      <div class="nv-wrap nv-split">
        <div><p class="nv-eyebrow"><i></i>Our legacy</p><p class="nv-secno">Section 02</p></div>
        <div>
          <h2 class="nv-h2">Over three decades of <em>trusted</em> professional services.</h2>
          <div class="nv-rows">
            {timeline.map((t) => (<div class="nv-row year"><span class="n">{t.year}</span><span class="t">{t.text}</span></div>))}
          </div>
        </div>
      </div>
    </section>

    <section class="band band-dark nv-sec">
      <div class="nv-wrap nv-split">
        <div><p class="nv-eyebrow"><i></i>Why work with us</p><p class="nv-secno">Section 03</p></div>
        <div>
          <h2 class="nv-h2">Four undertakings clients can <em>rely on.</em></h2>
          <div class="nv-rows">
            {promises.map((pr, k) => (<div class="nv-row"><span class="n">{String(k + 1).padStart(2, '0')}</span><span class="t">{pr}</span></div>))}
          </div>
          <ul class="nv-chips" aria-label="Our principles">{values.map((v) => <li>{v.name}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="band band-light nv-sec">
      <div class="nv-wrap">
        <p class="nv-eyebrow"><i></i>Sectors</p>
        <h2 class="nv-h2 mt-6 max-w-4xl">Industries we have <em>worked with.</em></h2>
        <ul class="nv-cells">
          {sectors.map((x, k) => (<li><span class="n">{k + 1}</span><span class="t">{x}</span></li>))}
        </ul>
        <a class="nv-btn line mt-10 max-w-xs" href="/industries">All industries we serve <span>→</span></a>
      </div>
    </section>

    <section class="band band-dark nv-sec">
      <div class="nv-wrap nv-split nv-faq">
        <div><p class="nv-eyebrow"><i></i>Queries</p><p class="nv-secno">Section 04</p></div>
        <div>
          <h2 class="nv-h2">Quick <em>answers.</em></h2>
          <div class="mt-10">
            {faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
          </div>
        </div>
      </div>
    </section>

    <section class="band nv-cta nv-sec">
      <div class="nv-wrap">
        <p class="nv-eyebrow"><i></i>Begin a conversation</p>
        <h2 class="nv-h2">A short conversation is the <em>best place to start.</em></h2>
        <p>Tell us a little about your business and what you are trying to address. We will arrange a call with the team member best suited to the work.</p>
        <a class="nv-btn solid" href="/contact">Schedule a consultation <span>→</span></a>
      </div>
    </section>
  </div>

  <!-- ============ Clean design ============ -->
  <div class="cl-only">
    <section class="cl-hero" id="cl-hero" data-types={JSON.stringify(enquiryTypes)}>
      <div class="cl-wrap cl-hero-grid">
        <div class="cl-hero-left">
          <div class="cl-hero-text">
            <p class="cl-pill" data-in style="--d:.05s"><i></i>Chartered Accountants · Est. {firm.established}</p>
            <h1 data-in style="--d:.15s">Building trust through <em>professional excellence.</em></h1>
            <p class="cl-lead" data-in style="--d:.28s">{firm.description}</p>
            <ul class="cl-trust" data-in style="--d:.4s">
              <li>Offices in Hyderabad &amp; Vijayawada</li>
              <li>{years}+ years of practice</li>
              <li>Tax · Assurance · Advisory</li>
            </ul>
            <a class="cl-call" href="tel:+914066462292" data-in style="--d:.5s">
              <span class="cl-call-ico"><Icon name="phone" size={20} /></span>
              <span><small>Prefer to talk? Call us</small><strong>040-66462292</strong></span>
            </a>
          </div>

          <!-- Live enquiry letter: appears while the form is being filled -->
          <div class="cl-hero-doc" aria-hidden="true">
            <div class="doc" id="hd-doc">
              <div class="doc-stamp">Received<br /><small>with thanks</small></div>
              <header class="doc-head">
                <p class="doc-firm">S.R. Garimella &amp; Co.,</p>
                <p class="doc-sub">Chartered Accountants · Est. {firm.established}</p>
                <p class="doc-sub">Hyderabad · Vijayawada · Rajahmundry · Kakinada</p>
              </header>
              <p class="doc-title"><span id="hd-title">Letter of Enquiry</span></p>
              <p class="doc-date"><span id="hd-date"></span></p>
              <p class="doc-to">To,<br />The Partners,<br />S.R. Garimella &amp; Co., Chartered Accountants</p>
              <p class="doc-line" data-hl="topic"><b>Subject:</b> Enquiry regarding <span class="out empty" data-h="topic" data-ph="our services"></span></p>
              <p class="doc-line">Dear Sirs,</p>
              <p class="doc-line" data-hl="message"><span class="out msg empty" data-h="message" data-ph="Your message will be written here as you type it…"></span></p>
              <div id="hd-encl" class="doc-encl" hidden>
                <p class="doc-h">Documents to keep ready</p>
                <ol id="hd-encl-list"></ol>
              </div>
              <ul class="doc-contact">
                <li data-hl="email"><b>Email</b><span class="out empty" data-h="email" data-ph="your@email.com"></span></li>
                <li data-hl="phone"><b>Phone</b><span class="out empty" data-h="phone" data-ph="—"></span></li>
              </ul>
              <div class="doc-sign" data-hl="name">
                <p>Yours sincerely,</p>
                <p class="sig" id="hd-sig"><span class="out empty" data-h="name" data-ph=""></span></p>
                <p class="sig-line"><span class="out empty" data-h="name2" data-ph="Your name"></span></p>
              </div>
            </div>
            <p class="label doc-note">Your enquiry letter is being written as you type</p>
          </div>
        </div>

        <!-- Quick enquiry -->
        <div class="cl-enq-wrap" data-in style="--d:.35s" id="cl-enq-wrap">
        <div class="gari-peek" aria-hidden="true">
          <p class="gari-bubble" id="gari-say">Hi! I'm Gari. Tell me what you need 👋</p>
          <Mascot mood="wave" size="7.2rem" follow class="gari-home" />
        </div>
        <div class="cl-enq" id="cl-enq">
          <div id="cl-enq-form-wrap">
            <p class="cl-enq-title">Request a call back</p>
            <p class="cl-enq-sub">Tell us what you need. Our team will get in touch shortly.</p>
            <form id="cl-quick" novalidate>
              <input type="text" name="website" tabindex="-1" autocomplete="off" class="cl-hp" aria-hidden="true" />
              <label class="cl-f"><span>What do you need help with?</span>
                <select name="topic">
                  <option value="">Select a service…</option>
                  {enquiryTypes.map((t) => <option value={t.title}>{t.title}</option>)}
                </select></label>
              <div class="cl-row2">
                <label class="cl-f"><span>Your name</span><input name="name" type="text" autocomplete="name" required maxlength="120" placeholder="Full name" /></label>
                <label class="cl-f"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" required maxlength="30" placeholder="Mobile number" /></label>
              </div>
              <label class="cl-f"><span>Email <em>(optional)</em></span><input name="email" type="email" autocomplete="email" maxlength="160" placeholder="you@company.com" /></label>
              <label class="cl-f"><span>Message <em>(optional)</em></span><textarea name="message" rows="3" maxlength="600" placeholder="A line or two about your requirement"></textarea></label>
              <button type="submit" class="cl-btn cl-enq-btn">Send enquiry <span aria-hidden="true">→</span></button>
              <p class="cl-enq-msg" id="cl-enq-msg" role="status"></p>
              <p class="cl-enq-note">Your details go only to our team. Prefer the full form? <a href="/contact">Open the detailed enquiry page</a>.</p>
            </form>
          </div>
          <div class="cl-enq-ok" id="cl-enq-ok" role="status">
            <svg viewBox="0 0 64 64" width="72" height="72" aria-hidden="true"><circle class="c1" cx="32" cy="32" r="28" fill="none" stroke="#16a34a" stroke-width="4"/><path class="c2" d="M19 33l9 9 17-19" fill="none" stroke="#16a34a" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <p class="cl-enq-title">Thank you<span id="cl-enq-name"></span>.</p>
            <p class="cl-enq-sub">Your enquiry has reached our team. We will contact you shortly.</p>
          </div>
        </div>
        </div>
      </div>
    </section>

    <div class="cl-wrap cl-stats-wrap">
      <ul class="cl-stats" aria-label="Firm at a glance">
        <li class="cl-stat"><b>{firm.established}</b><span>Established</span></li>
        <li class="cl-stat"><b data-count={years} data-suffix="+">{years}+</b><span>Years of practice</span></li>
        <li class="cl-stat"><b data-count={services.length}>{services.length}</b><span>Practice areas</span></li>
        <li class="cl-stat"><b data-count="4">4</b><span>Cities served</span></li>
      </ul>
    </div>

    <section class="cl-sec">
      <div class="cl-wrap">
        <div class="cl-head">
          <p class="cl-eyebrow">Our services</p>
          <h2>Eight practice areas, <em>one</em> standard of work.</h2>
          <p>From statutory audit and tax to GST, corporate law and advisory — everything a growing business needs from its chartered accountants.</p>
        </div>
        <div class="cl-grid">
          {services.map((sv, k) => (
            <a class="cl-card" href={`/services/${sv.slug}`}>
              <span class="cl-card-top"><span class="cl-ico"><Icon name={sv.icon} size={26} /></span><span class="cl-cnum">{String(k + 1).padStart(2, '0')}</span></span>
              <h3>{sv.title}</h3>
              <p>{sv.short}</p>
              <span class="cl-more">Learn more <i>→</i></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cl-sec cl-sec-flush">
      <div class="cl-wrap">
        <div class="cl-panel">
          <div class="cl-panel-text">
            <p class="cl-eyebrow cl-eyebrow-light">Why S.R. Garimella &amp; Co.</p>
            <h2>Technical expertise with practical business insight.</h2>
            <p>{firm.approach}</p>
            <div class="cl-big"><b>{years}+</b><span>years of trusted<br />professional services</span></div>
          </div>
          <ul class="cl-values">
            {values.map((v) => (
              <li><span class="cl-vico"><Icon name={v.icon} size={24} /></span><span>{v.name}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="cl-sec">
      <div class="cl-wrap">
        <div class="cl-head">
          <p class="cl-eyebrow">Our legacy</p>
          <h2>Over three decades of <em>trusted</em> professional services.</h2>
        </div>
        <ol class="cl-time">
          {timeline.map((t) => (<li><span class="cl-dot"></span><b>{t.year}</b><p>{t.text}</p></li>))}
        </ol>
      </div>
    </section>

    <section class="cl-sec cl-tint">
      <div class="cl-wrap">
        <div class="cl-head">
          <p class="cl-eyebrow">Our promise to clients</p>
          <h2>Four things you can <em>rely on.</em></h2>
        </div>
        <div class="cl-pair">
          {promises.map((pr, k) => (<div class="cl-prom"><b>{k + 1}</b><span>{pr}</span></div>))}
        </div>
        <div class="cl-head" style="margin-top:4.5rem">
          <p class="cl-eyebrow">Sectors</p>
          <h2>Experience across industries.</h2>
        </div>
        <ul class="cl-pills">{sectors.map((x) => <li>{x}</li>)}</ul>
      </div>
    </section>

    <section class="cl-sec">
      <div class="cl-wrap">
        <div class="cl-head">
          <p class="cl-eyebrow">Offices</p>
          <h2>Visit or call us.</h2>
          <p>Also serving clients in Rajahmundry and Kakinada.</p>
        </div>
        <div class="cl-offices">
          {offices.filter((o) => o.primary).map((o) => (
            <div class="cl-office">
              <span class="cl-ico"><Icon name="pin" size={24} /></span>
              <h3>{o.city}</h3>
              <address>
                {o.address?.map((l) => <span class="block">{l}</span>)}
                <span class="block">{o.city} – {o.postal}</span>
              </address>
              <div class="cl-office-links">
                <a href={`tel:${o.telHref}`}><Icon name="phone" size={18} /> {o.tel}</a>
                <a class="cl-mail-btn" href={`mailto:${o.email}`}><Icon name="mail" size={18} /> Email us</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cl-sec cl-tint">
      <div class="cl-wrap">
        <div class="cl-head"><p class="cl-eyebrow">Questions</p><h2>Quick answers</h2></div>
        <div class="cl-faq">{faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
      </div>
    </section>

    <section class="cl-cta">
      <div class="cl-wrap">
        <h2>A short conversation is the best place to start.</h2>
        <p>Tell us a little about your business and what you are trying to address.</p>
        <a class="cl-btn" href="/contact">Make a detailed enquiry</a>
      </div>
    </section>
  </div>

  <script>
    // Quick enquiry on the Clean home page -> /api/lead (emailed to the firm)
    import { mood, say } from '../lib/gari';
    const form = document.getElementById('cl-quick') as HTMLFormElement | null;
    const owl = document.querySelector('.gari-home');
    const bub = document.getElementById('gari-say');
    if (form && owl) {
      const f = form.elements;
      form.addEventListener('focusin', (e) => {
        const n = (e.target as HTMLInputElement).name;
        if (n === 'topic') { mood(owl, 'think'); say(bub, 'Pick the service you need help with.'); }
        else if (n === 'name') { mood(owl, 'write'); say(bub, 'Nice to meet you! What is your name?'); }
        else if (n === 'phone') { mood(owl, 'write'); say(bub, 'A mobile number so we can call you back.'); }
        else if (n === 'email') { mood(owl, 'write'); say(bub, 'Email is optional, but handy for documents.'); }
        else if (n === 'message') { mood(owl, 'write'); say(bub, 'A line or two is plenty. We will do the rest.'); }
      });
      form.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t.name === 'name' && t.value.trim().length > 1) say(bub, `Hello, ${t.value.trim().split(' ')[0]}! 😊`);
      });
      void f;
    }
    if (form) {
      const msg = document.getElementById('cl-enq-msg')!;
      const box = document.getElementById('cl-enq')!;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = new FormData(form);
        const name = String(f.get('name') || '').trim();
        const phone = String(f.get('phone') || '').trim();
        const email = String(f.get('email') || '').trim();
        const digits = phone.replace(/\D/g, '');
        msg.className = 'cl-enq-msg err';
        if (owl) mood(owl, 'worried');
        if (name.length < 2) { msg.textContent = 'Please enter your name.'; return; }
        if (digits.length < 10 || digits.length > 13) { msg.textContent = 'Please enter a valid mobile number.'; return; }
        if (email && !/^\S+@\S+\.\S+$/.test(email)) { msg.textContent = 'That email address does not look right.'; return; }
        msg.className = 'cl-enq-msg'; msg.textContent = 'Sending…'; btn.disabled = true;
        if (owl) { mood(owl, 'think'); say(bub, 'Sending your note to the team…'); }
        try {
          const res = await fetch('/api/lead', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ topic: f.get('topic'), name, phone, email, message: f.get('message'), page: location.pathname + ' (home enquiry)', website: f.get('website') }),
          });
          if (res.ok) {
            document.getElementById('cl-enq-name')!.textContent = ', ' + name.split(' ')[0];
            document.getElementById('hd-doc')?.classList.add('sent');
            document.getElementById('cl-hero')!.dataset.sent = '1';
            box.classList.add('done');
            if (owl) { mood(owl, 'celebrate'); say(bub, 'Done! Our team will call you soon 🎉'); }
            form.reset();
          } else {
            if (owl) { mood(owl, 'worried'); say(bub, 'Oops, that did not go through.'); }
            msg.className = 'cl-enq-msg err';
            msg.textContent = 'Sorry, we could not send that just now. Please call 040-66462292 or use the contact page.';
          }
        } catch {
          msg.className = 'cl-enq-msg err';
          msg.textContent = 'Network problem. Please try again or call 040-66462292.';
        }
        btn.disabled = false;
      });
    }

    // ---- Live enquiry letter: text fades out, the letter writes itself as the form is filled ----
    const hero = document.getElementById('cl-hero');
    const doc = document.getElementById('hd-doc');
    if (form && hero && doc) {
      type EType = { slug: string; title: string; docTitle: string; enclosures: string[] };
      const types: EType[] = JSON.parse(hero.dataset.types || '[]');
      const title = document.getElementById('hd-title')!;
      const encl = document.getElementById('hd-encl')!;
      const enclList = document.getElementById('hd-encl-list')!;
      const sig = document.getElementById('hd-sig')!;
      const dateEl = document.getElementById('hd-date');
      if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

      const setOut = (key: string, value: string) => {
        const keys = key === 'name' ? ['name', 'name2'] : [key];
        for (const k of keys) {
          doc.querySelectorAll<HTMLElement>(`[data-h="${k}"]`).forEach((el) => {
            if (el.textContent === value) return;
            el.textContent = value;
            el.classList.toggle('empty', !value);
            el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash');
          });
        }
        if (key === 'name') sig.classList.toggle('on', value.trim().length > 1);
      };
      const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      const read = (n: string) => field(n).value.trim();

      const renderType = () => {
        const t = types.find((x) => x.title === read('topic')) || null;
        title.textContent = t ? t.docTitle : 'Letter of Enquiry';
        setOut('topic', t ? t.title : '');
        enclList.innerHTML = '';
        for (const it of t?.enclosures ?? []) { const li = document.createElement('li'); li.textContent = it; enclList.appendChild(li); }
        encl.hidden = !(t && t.enclosures.length);
        doc.classList.remove('swap'); void doc.offsetWidth; doc.classList.add('swap');
      };

      const bindings: Record<string, () => void> = {
        topic: renderType,
        name: () => setOut('name', read('name')),
        phone: () => setOut('phone', read('phone')),
        email: () => setOut('email', read('email')),
        message: () => setOut('message', field('message').value),
      };
      for (const [n, fn] of Object.entries(bindings)) {
        const el = field(n);
        el.addEventListener('input', fn);
        el.addEventListener('change', fn);
        el.addEventListener('focus', () => {
          doc.querySelectorAll('.active').forEach((x) => x.classList.remove('active'));
          doc.querySelector(`[data-hl="${n}"]`)?.classList.add('active');
        });
      }

      const anyValue = () => ['topic', 'name', 'phone', 'email', 'message'].some((n) => field(n).value.trim() !== '');
      form.addEventListener('focusin', () => hero.classList.add('is-filling'));
      form.addEventListener('focusout', () => {
        setTimeout(() => {
          doc.querySelectorAll('.active').forEach((x) => x.classList.remove('active'));
          if (!form.contains(document.activeElement) && !anyValue() && !hero.dataset.sent) hero.classList.remove('is-filling');
        }, 150);
      });
    }
  </script>

