---
import ToolLayout from '../layouts/ToolLayout.astro';
import { CATEGORIES, RULES, whenText } from '../data/compliance';
---
<ToolLayout
  title="Compliance Calendar — GST, TDS, Income Tax, PF/ESI & ROC Due Dates"
  description="Upcoming statutory due dates for GST, TDS, income tax, payroll (PF/ESI) and company/LLP filings, with add-to-calendar links and a reminder sign-up."
  h1="Compliance calendar"
  intro="The due dates that matter, in one place. Filter by topic, see what is coming up, and add dates to your own calendar."
>
  <div class="cal-controls">
    <div>
      <p class="tool-lab">Show</p>
      <div class="chips cal-cats" id="cal-cats" role="group" aria-label="Categories">
        {CATEGORIES.map((c) => <button type="button" class="cal-chip" aria-pressed="true" data-cat={c}>{c}</button>)}
      </div>
    </div>
    <div>
      <p class="tool-lab">Next</p>
      <div class="seg" id="cal-range">
        <label><input type="radio" name="range" value="30" /><span>30 days</span></label>
        <label><input type="radio" name="range" value="60" checked /><span>60 days</span></label>
        <label><input type="radio" name="range" value="90" /><span>90 days</span></label>
      </div>
    </div>
    <button type="button" class="btn ghost" id="cal-ics">Download .ics</button>
  </div>

  <div id="cal-list" class="cal-list" aria-live="polite"></div>

  <div class="tool-grid cal-bottom">
    <form id="cal-sub" class="tool-card" novalidate>
      <p class="label">Reminder list</p>
      <h2 class="tool-h2">Get due-date reminders from our team</h2>
      <p class="tool-note">Tell us where to send them. We will email you the key dates for the topics you choose.</p>
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="cl-hp" aria-hidden="true" />
      <label class="tool-f"><span class="tool-lab">Email</span><input class="field" name="email" type="email" required maxlength="160" placeholder="you@company.com" autocomplete="email" /></label>
      <label class="tool-f"><span class="tool-lab">Name <small>(optional)</small></span><input class="field" name="name" type="text" maxlength="120" autocomplete="name" /></label>
      <div class="chips cal-subcats" id="sub-cats">
        {CATEGORIES.map((c) => <label class="tool-check cal-opt"><input type="checkbox" value={c} checked /> <span>{c}</span></label>)}
      </div>
      <button type="submit" class="btn" id="sub-btn">Join the reminder list</button>
      <p class="tool-note" id="sub-msg" role="status"></p>
    </form>

    <div class="tool-card">
      <p class="label">At a glance</p>
      <h2 class="tool-h2">Recurring due dates</h2>
      <table class="ltable tool-tbl">
        <thead><tr><th>Filing</th><th>When</th></tr></thead>
        <tbody>
          {RULES.map((r) => <tr><td>{r.title}<br /><small class="cal-cat">{r.cat}</small></td><td class="num">{whenText(r)}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div>
</ToolLayout>

<script>
  import { upcoming, type Cat } from '../data/compliance';
  const list = document.getElementById('cal-list')!;
  const MON = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const ymd = (d: Date) => `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const active = () => new Set([...document.querySelectorAll<HTMLElement>('.cal-chip[aria-pressed=true]')].map((b) => b.dataset.cat as Cat));
  const range = () => Number((document.querySelector('input[name=range]:checked') as HTMLInputElement).value);
  let current: ReturnType<typeof upcoming> = [];

  const gcal = (d: { rule: { title: string; detail: string }; date: Date }) => {
    const next = new Date(d.date.getFullYear(), d.date.getMonth(), d.date.getDate() + 1);
    const p = new URLSearchParams({ action: 'TEMPLATE', text: `Due: ${d.rule.title}`, details: `${d.rule.detail}\n\nConfirm dates with S.R. Garimella & Co.`, dates: `${ymd(d.date)}/${ymd(next)}` });
    return 'https://calendar.google.com/calendar/render?' + p.toString();
  };

  function render() {
    const cats = active();
    const today = new Date(); today.setHours(0, 0, 0, 0);
    current = upcoming(today, range()).filter((d) => cats.has(d.rule.cat));
    if (!current.length) { list.innerHTML = '<p class="tool-note">No due dates in this period for the selected topics.</p>'; return; }
    let html = '', month = '';
    for (const d of current) {
      const m = `${MON[d.date.getMonth()]} ${d.date.getFullYear()}`;
      if (m !== month) { month = m; html += `<h3 class="cal-month">${m}</h3>`; }
      const left = Math.round((d.date.getTime() - today.getTime()) / 86400000);
      const when = left === 0 ? 'Today' : left === 1 ? 'Tomorrow' : `In ${left} days`;
      html += `<article class="cal-item ${left <= 3 ? 'soon' : ''}">
        <div class="cal-date"><b>${d.date.getDate()}</b><span>${WD[d.date.getDay()]}</span></div>
        <div class="cal-body"><p class="cal-title">${esc(d.rule.title)}</p><p class="cal-detail">${esc(d.rule.detail)}${d.rule.note ? ' <em>' + esc(d.rule.note) + '</em>' : ''}</p></div>
        <div class="cal-side"><span class="cal-tag">${esc(d.rule.cat)}</span><span class="cal-left">${when}</span><a class="link" target="_blank" rel="noopener" href="${gcal(d)}">Add to Google Calendar</a></div>
      </article>`;
    }
    list.innerHTML = html;
  }

  document.getElementById('cal-cats')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')); render();
  });
  document.getElementById('cal-range')!.addEventListener('change', render);
  document.getElementById('cal-ics')!.addEventListener('click', () => {
    const stamp = new Date().toISOString().replace(/[-:]/g, '').slice(0, 15) + 'Z';
    const ev = current.map((d, i) => {
      const next = new Date(d.date.getFullYear(), d.date.getMonth(), d.date.getDate() + 1);
      return ['BEGIN:VEVENT', `UID:${d.rule.title.replace(/\W/g, '')}-${ymd(d.date)}-${i}@srgco.in`, `DTSTAMP:${stamp}`, `DTSTART;VALUE=DATE:${ymd(d.date)}`, `DTEND;VALUE=DATE:${ymd(next)}`, `SUMMARY:Due: ${d.rule.title.replace(/[,;]/g, ' ')}`, `DESCRIPTION:${d.rule.detail.replace(/[,;\n]/g, ' ')}`, 'END:VEVENT'].join('\r\n');
    });
    const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//S.R. Garimella & Co.//Compliance Calendar//EN', ...ev, 'END:VCALENDAR'].join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' })); a.download = 'compliance-due-dates.ics'; a.click();
  });
  render();

  // Reminder signup
  const form = document.getElementById('cal-sub') as HTMLFormElement;
  const msg = document.getElementById('sub-msg')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const email = String(f.get('email') || '').trim();
    if (!/^\S+@\S+\.\S+$/.test(email)) { msg.textContent = 'Please enter a valid email address.'; return; }
    const categories = [...document.querySelectorAll<HTMLInputElement>('#sub-cats input:checked')].map((i) => i.value);
    msg.textContent = 'Sending…';
    try {
      const res = await fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, name: f.get('name'), categories, website: f.get('website') }) });
      if (res.ok) { msg.textContent = 'Thank you — you are on the list. Please check your inbox for a confirmation.'; form.reset(); }
      else msg.textContent = 'Sorry, we could not add you just now. Please email us or try again later.';
    } catch { msg.textContent = 'Network problem. Please try again.'; }
  });
</script>
