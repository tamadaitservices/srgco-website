---
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
import { offices, firm, enquiryTypes } from '../data/site';
---
<Base title="Contact Us" description="Contact S.R. Garimella & Co., Chartered Accountants — offices in Hyderabad and Vijayawada. Call, email or write your enquiry and watch it take shape as a letter.">
  <section class="mx-auto max-w-6xl px-5 pt-14">
    <p class="label">Connect with us</p>
    <h1 class="mt-2">Make an enquiry</h1>
    <p class="mt-4 max-w-2xl text-xl">{firm.closing} Fill in the details and your letter to the firm is written beside you.</p>
    <div class="gari-row mt-6" aria-hidden="true"><Mascot mood="wave" size="5.2rem" follow class="gari-contact" /><p class="gari-bubble left" id="gari-say">Hi! I'm Gari. Choose what you need and I'll help write your letter.</p></div>

    <div class="mt-12 grid items-start gap-12 lg:grid-cols-[1fr_1.08fr]">
      <!-- FORM -->
      <form id="contact-form" method="post" action="/api/contact" class="space-y-6">
        <div class="hidden" aria-hidden="true"><label>Leave empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <fieldset class="types">
          <legend class="label">1 · What is your enquiry about?</legend>
          <div class="type-grid" role="radiogroup">
            {enquiryTypes.map((t) => (
              <label class="type-chip">
                <input type="radio" name="topic" value={t.title} data-type={t.slug} class="sr-only" />
                <span>{t.chip}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div id="extra-fields" class="space-y-6"></div>

        <p class="label !mt-8">2 · Your details</p>
        <label class="block"><span class="label">Your name</span>
          <input name="name" data-bind="name" required maxlength="120" autocomplete="name" class="field" /></label>
        <label class="block"><span class="label">Email</span>
          <input name="email" data-bind="email" type="email" required maxlength="160" autocomplete="email" class="field" /></label>
        <label class="block"><span class="label">Phone (optional)</span>
          <input name="phone" data-bind="phone" type="tel" maxlength="30" autocomplete="tel" class="field" /></label>

        <label class="block"><span class="label">Your message</span>
          <textarea name="message" data-bind="message" required rows="5" maxlength="3000" class="field border border-current p-3"></textarea></label>
        <button type="submit" class="btn">Send enquiry</button>
        <p id="form-status" class="text-lg" role="status"></p>
      </form>

      <!-- LIVE LETTER -->
      <div id="types-data" hidden data-json={JSON.stringify(enquiryTypes)}></div>
      <aside class="doc-wrap" aria-label="Live preview of your enquiry letter">
        <div class="doc" id="doc" aria-hidden="true">
          <div class="doc-stamp" id="doc-stamp">Received<br /><small>with thanks</small></div>

          <header class="doc-head">
            <p class="doc-firm">S.R. Garimella &amp; Co.</p>
            <p class="doc-sub">Chartered Accountants · Est. {firm.established}</p>
            <p class="doc-sub">Hyderabad · Vijayawada · Rajahmundry · Kakinada</p>
          </header>

          <p class="doc-title"><span id="doc-title">Letter of Enquiry</span></p>
          <p class="doc-date"><span id="doc-date"></span></p>

          <p class="doc-to">To,<br />The Partners,<br />S.R. Garimella &amp; Co., Chartered Accountants</p>

          <p class="doc-line" data-line="topic"><b>Subject:</b> Enquiry regarding <span class="out empty" data-out="topic" data-ph="our services"></span></p>

          <p class="doc-line">Dear Sirs,</p>

          <div id="doc-particulars" class="doc-part" hidden>
            <p class="doc-h">Particulars of enquiry</p>
            <ul id="doc-part-list"></ul>
          </div>

          <p class="doc-line" data-line="message"><span class="out msg empty" data-out="message" data-ph="Your message will be written here as you type it…"></span></p>

          <div id="doc-encl" class="doc-encl" hidden>
            <p class="doc-h">Documents to keep ready</p>
            <ol id="doc-encl-list"></ol>
          </div>

          <ul class="doc-contact">
            <li data-line="email"><b>Email</b><span class="out empty" data-out="email" data-ph="your@email.com"></span></li>
            <li data-line="phone"><b>Phone</b><span class="out empty" data-out="phone" data-ph="—"></span></li>
          </ul>

          <div class="doc-sign" data-line="name">
            <p>Yours sincerely,</p>
            <p class="sig" id="doc-sig"><span class="out empty" data-out="name" data-ph=""></span></p>
            <p class="sig-line"><span class="out empty" data-out="name-print" data-ph="Your name"></span></p>
          </div>
        </div>
        <p class="label doc-note" id="doc-note">Choose an enquiry type — the matching document appears here</p>
      </aside>
    </div>

    <div class="mt-20 grid gap-8 md:grid-cols-2">
      {offices.filter((o) => o.primary).map((o) => (
        <div class="box double p-6">
          <h2 class="text-3xl">{o.city}</h2>
          <address class="mt-3 text-lg not-italic">
            {o.address?.map((l) => <span class="block">{l}</span>)}
            <span class="block">{o.city} – {o.postal}</span>
            <a class="link block" href={`tel:${o.telHref}`}>Tel: {o.tel}</a>
            <a class="link block" href={`mailto:${o.email}`}>{o.email}</a>
          </address>
        </div>
      ))}
    </div>
    <p class="mt-6 text-lg">Other locations: Rajahmundry and Kakinada.</p>
  </section>


  <script>
    import { mood, say } from '../lib/gari';
    type Field = { id: string; label: string; type: 'text' | 'select'; placeholder?: string; options?: string[] };
    type EType = { slug: string; chip: string; title: string; docTitle: string; fields: Field[]; enclosures: string[] };

    const types: EType[] = JSON.parse((document.getElementById('types-data') as HTMLElement).dataset.json || '[]');
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    const doc = document.getElementById('doc');
    const sig = document.getElementById('doc-sig');
    const extra = document.getElementById('extra-fields')!;
    const partWrap = document.getElementById('doc-particulars')!;
    const partList = document.getElementById('doc-part-list')!;
    const enclWrap = document.getElementById('doc-encl')!;
    const enclList = document.getElementById('doc-encl-list')!;
    const docTitle = document.getElementById('doc-title')!;
    const note = document.getElementById('doc-note')!;
    const dateEl = document.getElementById('doc-date');
    if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

    const setOut = (key: string, value: string) => {
      const keys = key === 'name' ? ['name', 'name-print'] : [key];
      for (const k of keys) {
        document.querySelectorAll<HTMLElement>(`[data-out="${k}"]`).forEach((el) => {
          if (el.textContent === value) return;
          el.textContent = value;
          el.classList.toggle('empty', !value);
          el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash');
        });
      }
      if (key === 'name') sig?.classList.toggle('on', value.trim().length > 1);
    };

    function bind(el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) {
      const key = el.dataset.bind!;
      const update = () => setOut(key, el.value.trim() ? (key === 'message' ? el.value : el.value.trim()) : '');
      el.addEventListener('input', update);
      el.addEventListener('change', update);
      el.addEventListener('focus', () => {
        document.querySelectorAll('.doc .active').forEach((n) => n.classList.remove('active'));
        document.querySelector(`.doc [data-line="${key}"]`)?.classList.add('active');
      });
      el.addEventListener('blur', () => document.querySelectorAll('.doc .active').forEach((n) => n.classList.remove('active')));
      update();
    }
    form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[data-bind]').forEach(bind);

    function renderType(slug: string | null, animate = true) {
      const t = types.find((x) => x.slug === slug) || null;
      docTitle.textContent = t ? t.docTitle : 'Letter of Enquiry';
      setOut('topic', t ? t.title : '');
      note.textContent = t ? 'Your document updates as you type' : 'Choose an enquiry type — the matching document appears here';

      // form: type-specific questions
      extra.innerHTML = '';
      partList.innerHTML = '';
      for (const f of t?.fields ?? []) {
        const label = document.createElement('label');
        label.className = 'block';
        const cap = document.createElement('span');
        cap.className = 'label';
        cap.textContent = f.label;
        let input: HTMLInputElement | HTMLSelectElement;
        if (f.type === 'select') {
          input = document.createElement('select');
          input.className = 'field';
          const o0 = document.createElement('option'); o0.value = ''; o0.textContent = 'Select…'; input.appendChild(o0);
          for (const o of f.options ?? []) { const op = document.createElement('option'); op.value = o; op.textContent = o; input.appendChild(op); }
        } else {
          input = document.createElement('input');
          input.type = 'text';
          input.className = 'field';
          input.maxLength = 120;
          if (f.placeholder) input.placeholder = f.placeholder;
        }
        input.name = 'd:' + f.label;
        input.dataset.bind = 'x-' + f.id;
        label.append(cap, input);
        extra.appendChild(label);
        bind(input);

        // matching row in the document
        const li = document.createElement('li');
        li.dataset.line = 'x-' + f.id;
        const b = document.createElement('b'); b.textContent = f.label;
        const sp = document.createElement('span'); sp.className = 'out empty'; sp.dataset.out = 'x-' + f.id; sp.dataset.ph = '—';
        li.append(b, sp);
        partList.appendChild(li);
      }
      partWrap.hidden = !(t && t.fields.length);

      // checklist
      enclList.innerHTML = '';
      for (const item of t?.enclosures ?? []) { const li = document.createElement('li'); li.textContent = item; enclList.appendChild(li); }
      enclWrap.hidden = !(t && t.enclosures.length);

      if (animate && doc) { doc.classList.remove('swap'); void doc.offsetWidth; doc.classList.add('swap'); }
    }

    form?.querySelectorAll<HTMLInputElement>('input[name="topic"]').forEach((r) =>
      r.addEventListener('change', () => renderType(r.dataset.type || null)),
    );

    // deep link: /contact?type=gst-customs
    const wanted = new URLSearchParams(location.search).get('type');
    const pre = wanted && form?.querySelector<HTMLInputElement>(`input[name="topic"][data-type="${wanted}"]`);
    if (pre) { pre.checked = true; renderType(wanted, false); } else renderType(null, false);

    const owl = document.querySelector('.gari-contact'), bub = document.getElementById('gari-say');
    form?.addEventListener('focusin', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.type === 'radio' || t.tagName === 'SELECT') { mood(owl, 'think'); say(bub, 'Great choice. I have updated the documents list for you.'); }
      else if (t.name === 'name') { mood(owl, 'write'); say(bub, 'Your name goes on the letter as the signature.'); }
      else if (t.name === 'phone') { mood(owl, 'write'); say(bub, 'We will call you on this number.'); }
      else if (t.name === 'email') { mood(owl, 'write'); say(bub, 'Optional, but useful for sending documents.'); }
      else if (t.name === 'message' || t.tagName === 'TEXTAREA') { mood(owl, 'write'); say(bub, 'Write freely. It appears in your letter.'); }
    });
    form?.addEventListener('change', (e) => { if ((e.target as HTMLInputElement).type === 'radio') { mood(owl, 'think'); say(bub, 'Nice. Now a few details about you.'); } });
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      mood(owl, 'think'); say(bub, 'Sending your letter…');
      if (status) status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          doc?.classList.add('sent'); mood(owl, 'celebrate'); say(bub, 'Sent! The team will be in touch soon 🎉');
          if (status) status.textContent = 'Thank you — your enquiry has been received. We will be in touch soon.';
        } else { mood(owl, 'worried'); say(bub, 'Hmm, that did not work. Please check the details.'); if (status) status.textContent = data.error || 'Something went wrong. Please call or email us.'; }
      } catch {
        mood(owl, 'worried');
        if (status) status.textContent = 'Network error. Please call or email us.';
      }
    });
  </script>
</Base>
