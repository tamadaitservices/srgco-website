---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import Motion from '../components/Motion.astro';
import Lang from '../components/Lang.astro';
import { firm, offices } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description, ogType = 'website', jsonLd, noindex = false } = Astro.props;

const site = (Astro.site ?? new URL('https://srgco.in')).toString().replace(/\/$/, '');
const path = Astro.url.pathname;
const canonical = site + path;
const fullTitle = path === '/' ? title : `${title} | ${firm.name}`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  '@id': `${site}/#organization`,
  name: firm.name,
  url: site,
  description: firm.description,
  foundingDate: String(firm.established),
  slogan: firm.tagline,
  areaServed: ['Hyderabad', 'Vijayawada', 'Rajahmundry', 'Kakinada', 'India'],
  location: offices
    .filter((o) => o.primary)
    .map((o) => ({
      '@type': 'AccountingService',
      name: `${firm.name} — ${o.city}`,
      telephone: o.telHref,
      email: o.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: o.address?.join(', '),
        addressLocality: o.city,
        addressRegion: o.region,
        postalCode: o.postal,
        addressCountry: 'IN',
      },
      geo: o.geo && { '@type': 'GeoCoordinates', latitude: o.geo.lat, longitude: o.geo.lng },
    })),
};
const ld = [orgLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121722" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Set theme before first paint (no flash). A visitor's saved choice wins if that theme is still enabled;
      // otherwise the default chosen in /admin (Navy & Copper until changed) is used.
      (function () {
        var ALL = ['clean', 'navy', 'light', 'dark', 'emerald', 'republic', 'independence', 'gandhi'];
        // festival of the day, by Indian time: 26 Jan, 15 Aug, 2 Oct
        function festival() { var n = new Date(Date.now() + 19800000), m = n.getUTCMonth() + 1, d = n.getUTCDate(); return m === 1 && d === 26 ? 'republic' : m === 8 && d === 15 ? 'independence' : m === 10 && d === 2 ? 'gandhi' : null; }
        var root = document.documentElement;
        function cfg() {
          var c = null; try { c = JSON.parse(localStorage.getItem('srg-cfg')); } catch (e) {}
          var en = (c && c.enabled || []).filter(function (x) { return ALL.indexOf(x) > -1; });
          if (!en.length) en = ALL.slice();
          var d = c && en.indexOf(c.def) > -1 ? c.def : en.indexOf('navy') > -1 ? 'navy' : en[0];
          var f = festival();
          if (f && (!c || c.occ !== false) && en.indexOf(f) > -1) d = f; // new visitors see the festival theme on its day
          return { enabled: en, def: d };
        }
        function apply() {
          var c = cfg(), saved = null;
          try { saved = localStorage.getItem('srg-theme'); } catch (e) {}
          var t = saved && c.enabled.indexOf(saved) > -1 ? saved : c.def;
          if (root.dataset.theme !== t) { root.dataset.theme = t; document.dispatchEvent(new Event('srg:theme')); }
          var css = ALL.filter(function (x) { return c.enabled.indexOf(x) < 0; }).map(function (x) { return '[data-theme-choice="' + x + '"]{display:none!important}'; }).join('');
          if (c.enabled.length < 2) css += '#theme-switch,#theme-pop{display:none!important}';
          var st = document.getElementById('srg-theme-css');
          if (!st) { st = document.createElement('style'); st.id = 'srg-theme-css'; document.head.appendChild(st); }
          st.textContent = css;
        }
        apply();
        try {
          fetch('/api/site-settings').then(function (r) { return r.ok ? r.json() : null; }).then(function (j) {
            if (!j || !j.enabled) return;
            try { localStorage.setItem('srg-cfg', JSON.stringify(j)); } catch (e) {}
            apply();
          }).catch(function () {});
        } catch (e) {}
        var l = null; try { l = localStorage.getItem('srg-lang'); } catch (e) {}
        if (l === 'te' || l === 'hi') { root.dataset.lang = l; root.lang = l; }
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={firm.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og-default.svg`} />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <ChatWidget />
    <Motion />
    <Lang />
  </body>
</html>
