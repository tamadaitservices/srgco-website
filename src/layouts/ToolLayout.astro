---
import Base from './Base.astro';
import { TAX_META } from '../lib/tax';

interface Props { title: string; description: string; h1: string; intro: string; rates?: boolean }
const { title, description, h1, intro, rates = false } = Astro.props;
const site = (Astro.site ?? new URL('https://srgco.in')).toString().replace(/\/$/, '');
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: site + '/tools' },
    { '@type': 'ListItem', position: 3, name: h1 },
  ] },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: h1, description, applicationCategory: 'FinanceApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' }, provider: { '@type': 'AccountingService', name: 'S.R. Garimella & Co.' } },
];
---
<Base title={title} description={description} jsonLd={ld}>
  <section class="mx-auto max-w-6xl px-5 pt-14">
    <nav class="label" aria-label="Breadcrumb"><a class="link" href="/tools">Tools</a> / {h1}</nav>
    <h1 class="mt-3 max-w-4xl !text-4xl md:!text-6xl">{h1}</h1>
    <p class="mt-5 max-w-3xl text-xl">{intro}</p>
    <slot />
    <div class="tool-disclaimer">
      <p><strong>Please note.</strong> This tool gives an indicative estimate for general information and is not tax advice. Tax laws, rates and due dates change{rates ? ` — the rates used here follow the slabs for FY ${TAX_META.fy} (AY ${TAX_META.ay})` : ''}. Your actual liability depends on your complete facts. Please confirm with our team before acting.</p>
      <div class="tool-cta">
        <a class="btn" href="/book">Book a call with a CA</a>
        <a class="btn ghost" href="/contact">Send an enquiry</a>
      </div>
    </div>
  </section>
</Base>
