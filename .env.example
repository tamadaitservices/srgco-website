PUBLIC_SITE_URL=https://srgco.in
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=website@srgco.in
SMTP_PASS=
CONTACT_TO=sandeepgdps@srgco.in
# Digits only, with country code, e.g. 919876543210. Must be a WhatsApp-enabled mobile number.
PUBLIC_WHATSAPP=
# Optional: also copy every enquiry to a second address
CONTACT_CC=
# Admin panel (/admin). Leave ADMIN_PASSWORD empty to keep the admin switched off.
ADMIN_PASSWORD=
# Where edited About content and uploaded photos are stored. Use a folder OUTSIDE the app
# (e.g. /home/<user>/srg-data) so re-deploys do not erase it. Defaults to ./data
DATA_DIR=
